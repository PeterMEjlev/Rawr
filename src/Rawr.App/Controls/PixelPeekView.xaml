<UserControl x:Class="Rawr.App.Controls.PixelPeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged">
    <Border Background="#FF101010"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- Canvas measures with infinite available size, so the Image
                 (Stretch=None) gets its full natural pixel dimensions; the
                 Grid clips the visible region. -->
            <Canvas ClipToBounds="False">
                <Image x:Name="PeekImage"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True"
                       RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PeekScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PeekTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
            <Path Stroke="#80FFFFFF" StrokeThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M -6,0 L 6,0 M 0,-6 L 0,6"
                  IsHitTestVisible="False"
                  Panel.ZIndex="10" />
            <Border Background="#AA000000"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="4,2" Margin="4"
                    CornerRadius="2"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10">
                <TextBlock x:Name="ZoomLabel" Text="1:1" Foreground="White" FontSize="10" />
            </Border>
            <TextBlock x:Name="HintText"
                       Text="Shift + click on the preview to choose a focus point"
                       Foreground="#80FFFFFF"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="20"
                       IsHitTestVisible="False"
                       Panel.ZIndex="5" />
        </Grid>
    </Border>
</UserControl>
