<Window x:Class="Rawr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:Rawr.App.ViewModels"
        xmlns:models="clr-namespace:Rawr.Core.Models;assembly=Rawr.Core"
        xmlns:controls="clr-namespace:Rawr.App.Controls"
        xmlns:flyleaf="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        mc:Ignorable="d"
        Title="RAWR - RAW Photo Culling"
        Icon="Assets/rawr.ico"
        Height="800" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Single knob for the fullscreen burst-group badge size — bump this to taste -->
        <sys:Double x:Key="BurstBadgeFontSize">22</sys:Double>
    </Window.Resources>

    <!-- Window.InputBindings are populated programmatically in MainWindow.xaml.cs
         via Rawr.App.Shortcuts.ShortcutBinder so they can be customised in Settings. -->

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                              <!-- Toolbar -->
            <RowDefinition Height="*" />                                 <!-- Main split (preview + metadata) + action bar -->
            <RowDefinition Height="4" />                                 <!-- Filmstrip splitter -->
            <RowDefinition Height="148" MinHeight="80" MaxHeight="400"/> <!-- Filmstrip -->
            <RowDefinition Height="Auto" />                              <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ================ TOOLBAR ================ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="📂 Open Folder…" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" ToolTip="Ctrl+O" />
                <Button DockPanel.Dock="Left" Content="📥 Import…" Click="OnImportFromCard" Margin="0,0,8,0"
                        ToolTip="Import photos and videos from a connected SD / CF card. (Ctrl+I)" />
                <Button DockPanel.Dock="Left" Content="📝 Sync XMP" Command="{Binding SyncAllXmpCommand}" Margin="0,0,8,0"
                        ToolTip="{Binding SyncXmpTooltip}" />
                <Button DockPanel.Dock="Left" Content="🗺 Map" Click="OnOpenMap" Margin="0,0,8,0"
                        ToolTip="Plot photos with GPS data on a map and filter by region." />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <Button DockPanel.Dock="Left" Content="↶" Command="{Binding UndoCommand}"
                        Margin="0,0,4,0" Padding="8,2" FontSize="14"
                        ToolTip="{Binding UndoTooltip}" />
                <Button DockPanel.Dock="Left" Content="↷" Command="{Binding RedoCommand}"
                        Margin="0,0,8,0" Padding="8,2" FontSize="14"
                        ToolTip="{Binding RedoTooltip}" />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <!-- Filter dropdown -->
                <Grid DockPanel.Dock="Left" Margin="0,0,8,0">
                    <ToggleButton x:Name="FilterToggleButton"
                                  IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}"
                                  PreviewMouseLeftButtonDown="FilterToggleButton_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="FilterToggleButton_PreviewMouseLeftButtonUp"
                                  ToolTip="Filter photos by rating, flag, color, burst, or tag  -  Ctrl+Shift+X to clear all filters">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        🔍 Filter
                    </ToggleButton>

                    <Popup x:Name="FilterPopup"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=FilterToggleButton}"
                           Closed="FilterPopup_Closed"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="10,8">
                            <StackPanel>

                                <!-- Rating -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="RATING" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding RatingFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">

                                    <!-- Any + mode toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Button Content="Any" Command="{Binding ClearRatingFilterCommand}" Margin="0,0,3,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RatingFilterMode}" Value="Any">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding RatingModeLabel}" Command="{Binding CycleRatingModeCommand}" Width="28" />
                                    </StackPanel>

                                    <!-- Star buttons 0–5. Click + Tag instead of Command/CommandParameter
                                         so the handler can detect Shift for multi-select toggling.
                                         The DataTrigger MultiBinding asks the SetContains converter
                                         whether this button's value is in RatingFilterActiveValues. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="RatingValueButton_Click" Margin="0,0,3,0">
                                            <Button.Tag><sys:Int32>0</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>0</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            0★
                                        </Button>
                                        <Button Click="RatingValueButton_Click" Margin="0,0,3,0">
                                            <Button.Tag><sys:Int32>1</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>1</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            1★
                                        </Button>
                                        <Button Click="RatingValueButton_Click" Margin="0,0,3,0">
                                            <Button.Tag><sys:Int32>2</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>2</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            2★
                                        </Button>
                                        <Button Click="RatingValueButton_Click" Margin="0,0,3,0">
                                            <Button.Tag><sys:Int32>3</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>3</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            3★
                                        </Button>
                                        <Button Click="RatingValueButton_Click" Margin="0,0,3,0">
                                            <Button.Tag><sys:Int32>4</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>4</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            4★
                                        </Button>
                                        <Button Click="RatingValueButton_Click">
                                            <Button.Tag><sys:Int32>5</sys:Int32></Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SetContains}">
                                                                    <Binding Path="RatingFilterActiveValues" />
                                                                    <Binding><Binding.Source><sys:Int32>5</sys:Int32></Binding.Source></Binding>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            5★
                                        </Button>
                                    </StackPanel>

                                </StackPanel>

                                <!-- Flag -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="FLAG" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding FlagFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearFlagFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlagFilter}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Pick" Click="FlagFilterButton_Click"
                                            Tag="{x:Static models:CullFlag.Pick}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="FlagFilterActiveValues" />
                                                                <Binding Source="{x:Static models:CullFlag.Pick}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Reject" Click="FlagFilterButton_Click"
                                            Tag="{x:Static models:CullFlag.Reject}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="FlagFilterActiveValues" />
                                                                <Binding Source="{x:Static models:CullFlag.Reject}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Unflagged" Click="FlagFilterButton_Click"
                                            Tag="{x:Static models:CullFlag.Unflagged}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="FlagFilterActiveValues" />
                                                                <Binding Source="{x:Static models:CullFlag.Unflagged}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Color -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="COLOR" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding ColorLabelFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearColorLabelFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ColorLabelFilter}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="No Color" Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.None}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.None}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.Red}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.Red}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                     Fill="{Binding Source={x:Static models:ColorLabel.Red}, Converter={StaticResource LabelToBrush}}" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.Yellow}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.Yellow}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                     Fill="{Binding Source={x:Static models:ColorLabel.Yellow}, Converter={StaticResource LabelToBrush}}" />
                                            <TextBlock Text="Yellow" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.Green}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.Green}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                     Fill="{Binding Source={x:Static models:ColorLabel.Green}, Converter={StaticResource LabelToBrush}}" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.Blue}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.Blue}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                     Fill="{Binding Source={x:Static models:ColorLabel.Blue}, Converter={StaticResource LabelToBrush}}" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorLabelFilterButton_Click"
                                            Tag="{x:Static models:ColorLabel.Purple}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ColorLabelFilterActiveValues" />
                                                                <Binding Source="{x:Static models:ColorLabel.Purple}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                     Fill="{Binding Source={x:Static models:ColorLabel.Purple}, Converter={StaticResource LabelToBrush}}" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Bursts -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="BURSTS" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding BurstFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearBurstFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BurstFilter}" Value="Any">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Bursts only"
                                            Command="{Binding SetBurstFilterCommand}"
                                            CommandParameter="{x:Static vm:BurstFilterMode.OnlyInBursts}"
                                            Margin="0,0,3,0"
                                            ToolTip="Show only photos that are part of a burst">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BurstFilter}" Value="OnlyInBursts">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Singles only"
                                            Command="{Binding SetBurstFilterCommand}"
                                            CommandParameter="{x:Static vm:BurstFilterMode.OnlySingles}"
                                            ToolTip="Hide photos that are part of a burst">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BurstFilter}" Value="OnlySingles">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Type -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="TYPE" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding ImageTypeFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearImageTypeFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageTypeFilter}" Value="Any">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="RAW only"
                                            Click="ImageTypeFilterButton_Click"
                                            Tag="{x:Static vm:ImageTypeFilterMode.RawOnly}"
                                            Margin="0,0,3,0"
                                            ToolTip="Show only RAW files">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ImageTypeFilterActiveValues" />
                                                                <Binding Source="{x:Static vm:ImageTypeFilterMode.RawOnly}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="JPG only"
                                            Click="ImageTypeFilterButton_Click"
                                            Tag="{x:Static vm:ImageTypeFilterMode.JpegOnly}"
                                            Margin="0,0,3,0"
                                            ToolTip="Show only JPEG files">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ImageTypeFilterActiveValues" />
                                                                <Binding Source="{x:Static vm:ImageTypeFilterMode.JpegOnly}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Video only"
                                            Click="ImageTypeFilterButton_Click"
                                            Tag="{x:Static vm:ImageTypeFilterMode.VideoOnly}"
                                            ToolTip="Show only videos">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                <Binding Path="ImageTypeFilterActiveValues" />
                                                                <Binding Source="{x:Static vm:ImageTypeFilterMode.VideoOnly}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Exposure -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="EXPOSURE" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding ExposureFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearExposureFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExposureFilter}" Value="Any">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Clipped highlights"
                                            Command="{Binding SetExposureFilterCommand}"
                                            CommandParameter="{x:Static vm:ExposureFilterMode.ClippedHighlights}"
                                            Margin="0,0,3,0"
                                            ToolTip="Show photos whose highlight-clipped pixel area exceeds the threshold in Settings">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExposureFilter}" Value="ClippedHighlights">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Crushed shadows"
                                            Command="{Binding SetExposureFilterCommand}"
                                            CommandParameter="{x:Static vm:ExposureFilterMode.CrushedShadows}"
                                            ToolTip="Show photos whose crushed-shadow pixel area exceeds the threshold in Settings">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExposureFilter}" Value="CrushedShadows">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Time of day -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="TIME OF DAY" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding TimeOfDayFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10" Width="260">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Width="56"
                                             HorizontalContentAlignment="Center"
                                             Text="{Binding TimeOfDayStartText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Window start (HH:mm)" />
                                    <TextBox Grid.Row="0" Grid.Column="2"
                                             Width="56"
                                             HorizontalContentAlignment="Center"
                                             Text="{Binding TimeOfDayEndText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Window end (HH:mm). If end is earlier than start the window straddles midnight." />
                                    <Button Grid.Row="0" Grid.Column="3"
                                            Content="Any"
                                            Command="{Binding ClearTimeOfDayFilterCommand}"
                                            Margin="6,0,0,0"
                                            ToolTip="Clear time-of-day filter">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTimeOfDayFilterActive}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <controls:RangeSlider Grid.Row="1" Grid.ColumnSpan="4"
                                                          Margin="0,8,0,0"
                                                          Minimum="0" Maximum="1440" Step="15"
                                                          LowerValue="{Binding TimeOfDayStartMinutes, Mode=TwoWay}"
                                                          UpperValue="{Binding TimeOfDayEndMinutes,   Mode=TwoWay}"
                                                          IsDragging="{Binding IsTimeOfDaySliderDragging, Mode=TwoWay}" />
                                </Grid>

                                <!-- Camera. Auto-populated from EXIF on currently-loaded photos. WrapPanel
                                     stays empty until metadata extraction has surfaced at least one camera. -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="CAMERA" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,0,0,0">
                                        <Button Content="Any" Command="{Binding ClearCameraFilterCommand}" Margin="0,0,3,3">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCameraFilterActive}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding AvailableCameras}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Click="CameraFilterButton_Click"
                                                            Margin="0,0,3,3">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                                                <Binding Path="DataContext.CameraFilters" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                <Binding />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Groups -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="TAGS" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource FilterPolarityToggleStyle}"
                                                  IsChecked="{Binding TagFilterExclude}"
                                                  Margin="8,0,0,0" />
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="Any" Command="{Binding ClearTagFilterCommand}" Margin="0,0,3,3">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TagFilter}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Click="TagFilterButton_Click"
                                                        Margin="0,0,3,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource SetContains}">
                                                                            <Binding Path="DataContext.TagFilterActiveIds" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="Id" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Rename tag…"
                                                                      Command="{Binding PlacementTarget.Tag.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="Delete tag"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Tag>
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </Button.Tag>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+" Command="{Binding CreateTagCommand}" ToolTip="{Binding CreateTagTooltip}" Margin="0,0,0,3" />
                                </WrapPanel>

                                <Separator Margin="0,2,0,8" />
                                <TextBlock Text="Shift+click to select multiple values"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Margin="0,0,0,6" />
                                <Button Content="Clear All Filters" Command="{Binding ClearFiltersCommand}"
                                        HorizontalAlignment="Stretch" ToolTip="Ctrl+Shift+X" />

                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <!-- Burst collapse toggle -->
                <ToggleButton DockPanel.Dock="Left"
                              IsChecked="{Binding BurstCollapsed}"
                              Width="30"
                              Height="26"
                              Padding="0"
                              FontSize="15"
                              Margin="0,0,8,0">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <!-- Default (unchecked = expanded): pressing collapses -->
                            <Setter Property="Content" Value="⊟" />
                            <Setter Property="ToolTip" Value="G - collapse bursts to a single tile" />
                            <Style.Triggers>
                                <!-- Checked (collapsed): pressing expands -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="⊞" />
                                    <Setter Property="ToolTip" Value="G - expand burst tiles" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button DockPanel.Dock="Left"
                        Content="↬ Last Edit"
                        Command="{Binding GoToLastInteractedPhotoCommand}"
                        Margin="0,0,8,0"
                        ToolTip="Go to the last visible photo with a rating, flag, color label, or tag" />

                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <!-- Tags management button -->
                <Grid DockPanel.Dock="Left" Margin="0,0,8,0">
                    <ToggleButton x:Name="TagsToggleButton"
                                  IsChecked="{Binding IsOpen, ElementName=TagsPopup, Mode=TwoWay}"
                                  PreviewMouseLeftButtonDown="TagsToggleButton_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="TagsToggleButton_PreviewMouseLeftButtonUp"
                                  Content="🏷 Tags"
                                  ToolTip="{Binding OpenTagsTooltip}" />
                    <Popup x:Name="TagsPopup"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=TagsToggleButton}"
                           Closed="TagsPopup_Closed"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="10,8"
                                MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="TAGS" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Padding="6,2"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete tag">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button DockPanel.Dock="Right"
                                                        Content="✎"
                                                        Padding="6,2"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Rename tag">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="auto"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           FontSize="10"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Automatically managed by RAWR - can't be renamed or deleted">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,4,0,8" />
                                <Button Content="+ New Tag" Command="{Binding CreateTagCommand}"
                                        HorizontalAlignment="Stretch" ToolTip="{Binding CreateTagTooltip}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <TextBlock DockPanel.Dock="Left"
                           Text="Sort"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,6,0" />
                <ComboBox DockPanel.Dock="Left"
                          SelectedValue="{Binding SortField, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          MinWidth="70"
                          Margin="0,0,4,0"
                          ToolTip="Sort photos by this field">
                    <ComboBoxItem Content="Name"   Tag="{x:Static vm:SortField.FileName}" />
                    <ComboBoxItem Content="Rating" Tag="{x:Static vm:SortField.Rating}" />
                    <ComboBoxItem Content="Date"   Tag="{x:Static vm:SortField.CaptureDate}" />
                    <ComboBoxItem Content="Color"  Tag="{x:Static vm:SortField.ColorLabel}" />
                    <ComboBoxItem Content="Flag"   Tag="{x:Static vm:SortField.Flag}" />
                    <ComboBoxItem Content="Burst"  Tag="{x:Static vm:SortField.Burst}" />
                    <ComboBoxItem Content="Type"   Tag="{x:Static vm:SortField.ImageType}" />
                </ComboBox>
                <Button DockPanel.Dock="Left" Content="{Binding SortDirectionLabel}" Command="{Binding ToggleSortDirectionCommand}" Margin="0,0,8,0" ToolTip="{Binding SortDirectionTooltip}" />

                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <!-- Copy dropdown -->
                <Grid DockPanel.Dock="Left" Margin="0,0,4,0">
                    <ToggleButton x:Name="CopyToggleButton"
                                  IsChecked="{Binding IsOpen, ElementName=CopyPopup, Mode=TwoWay}"
                                  PreviewMouseLeftButtonDown="CopyToggleButton_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="CopyToggleButton_PreviewMouseLeftButtonUp"
                                  Content="📤 Export…"
                                  ToolTip="Choose which photos to export" />
                    <Popup x:Name="CopyPopup"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=CopyToggleButton}"
                           Closed="CopyPopup_Closed"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="10,8">
                            <StackPanel>

                                <!-- Source -->
                                <TextBlock Text="SOURCE" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Binding SelectedPhotosCount}"
                                            ContentStringFormat="Current selection ({0})"
                                            Command="{Binding UseCopySelectedPhotosCommand}" Margin="0,0,3,0"
                                            ToolTip="Export the photos you've selected in the grid / filmstrip (Ctrl-click and Shift-click to multi-select)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyMode}" Value="SelectedPhotos">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding CurrentViewCount}"
                                            ContentStringFormat="Current view ({0})"
                                            Command="{Binding UseCopyCurrentViewCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyMode}" Value="CurrentView">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Custom filter" Command="{Binding UseCopyCustomFilterCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyMode}" Value="CustomFilter">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Custom filter criteria (only shown when source is "Custom filter") -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CopyMode}" Value="CustomFilter">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                <!-- Rating -->
                                <TextBlock Text="RATING" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Button Content="Any" Command="{Binding ClearCopyRatingFilterCommand}" Margin="0,0,3,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CopyRatingFilterMode}" Value="Any">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding CopyRatingModeLabel}" Command="{Binding CycleCopyRatingModeCommand}" Width="28" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding SetCopyRatingValueCommand}" Margin="0,0,3,0">
                                            <Button.CommandParameter><sys:Int32>0</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="0"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            0★
                                        </Button>
                                        <Button Command="{Binding SetCopyRatingValueCommand}" Margin="0,0,3,0">
                                            <Button.CommandParameter><sys:Int32>1</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="1"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            1★
                                        </Button>
                                        <Button Command="{Binding SetCopyRatingValueCommand}" Margin="0,0,3,0">
                                            <Button.CommandParameter><sys:Int32>2</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="2"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            2★
                                        </Button>
                                        <Button Command="{Binding SetCopyRatingValueCommand}" Margin="0,0,3,0">
                                            <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="3"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            3★
                                        </Button>
                                        <Button Command="{Binding SetCopyRatingValueCommand}" Margin="0,0,3,0">
                                            <Button.CommandParameter><sys:Int32>4</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="4"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            4★
                                        </Button>
                                        <Button Command="{Binding SetCopyRatingValueCommand}">
                                            <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyActiveRatingValue}" Value="5"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            5★
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Flag -->
                                <TextBlock Text="FLAG" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearCopyFlagFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyFlagFilter}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Pick" Command="{Binding SetCopyFlagFilterCommand}"
                                            CommandParameter="{x:Static models:CullFlag.Pick}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyFlagFilter}" Value="{x:Static models:CullFlag.Pick}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Reject" Command="{Binding SetCopyFlagFilterCommand}"
                                            CommandParameter="{x:Static models:CullFlag.Reject}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyFlagFilter}" Value="{x:Static models:CullFlag.Reject}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Unflagged" Command="{Binding SetCopyFlagFilterCommand}"
                                            CommandParameter="{x:Static models:CullFlag.Unflagged}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyFlagFilter}" Value="{x:Static models:CullFlag.Unflagged}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Color -->
                                <TextBlock Text="COLOR" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Any" Command="{Binding ClearCopyColorLabelFilterCommand}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="No Color" Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.None}" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.None}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.Red}" Margin="0,0,3,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.Red}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Source={x:Static models:ColorLabel.Red}, Converter={StaticResource LabelToBrush}}" /><TextBlock Text="Red" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.Yellow}" Margin="0,0,3,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.Yellow}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Source={x:Static models:ColorLabel.Yellow}, Converter={StaticResource LabelToBrush}}" /><TextBlock Text="Yellow" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.Green}" Margin="0,0,3,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.Green}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Source={x:Static models:ColorLabel.Green}, Converter={StaticResource LabelToBrush}}" /><TextBlock Text="Green" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.Blue}" Margin="0,0,3,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.Blue}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Source={x:Static models:ColorLabel.Blue}, Converter={StaticResource LabelToBrush}}" /><TextBlock Text="Blue" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetCopyColorLabelFilterCommand}"
                                            CommandParameter="{x:Static models:ColorLabel.Purple}">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CopyColorLabelFilter}" Value="{x:Static models:ColorLabel.Purple}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Source={x:Static models:ColorLabel.Purple}, Converter={StaticResource LabelToBrush}}" /><TextBlock Text="Purple" /></StackPanel>
                                    </Button>
                                </StackPanel>

                                </StackPanel>
                                <!-- end custom filter criteria -->

                                <!-- Quality -->
                                <TextBlock Text="QUALITY" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CopyQualityLabel}" VerticalAlignment="Center"
                                                   MinWidth="50" TextAlignment="Right" Margin="8,0,0,0" />
                                        <Slider Style="{StaticResource QualitySliderStyle}"
                                                Minimum="0" Maximum="4" Value="{Binding CopyQualityIndex}"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                TickPlacement="BottomRight" SmallChange="1" LargeChange="1"
                                                ToolTip="Slide left for smaller JPEGs, right for the original RAW" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CopyQualityDescription}" Foreground="{StaticResource TextDimBrush}"
                                               FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Rename -->
                                <TextBlock Text="RENAME" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox Content="Rename files" IsChecked="{Binding CopyRenameEnabled}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CopyRenameEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Column="1" Text="{Binding CopyCustomBaseName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CopyRenameEnabled}" MinWidth="120" />
                                        <TextBlock Grid.Column="2" Text="_001.ext" VerticalAlignment="Center" Margin="3,0,0,0"
                                                   Foreground="{StaticResource TextDimBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CopyRenameEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Operation -->
                                <TextBlock Text="OPERATION" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Copy" Command="{Binding UseCopyOperationCommand}" Margin="0,0,3,0"
                                            ToolTip="Copy photos to the destination, leaving the originals in place">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyOperation}" Value="Copy">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Move" Command="{Binding UseMoveOperationCommand}"
                                            ToolTip="Copy photos to the destination, then send the originals to the Recycle Bin">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyOperation}" Value="Move">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <Separator Margin="0,2,0,8" />
                                <Button Content="📤 Export…" Command="{Binding CopyPickedCommand}"
                                        HorizontalAlignment="Stretch" ToolTip="Ctrl+C — export matching photos to a folder" />

                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
<Button DockPanel.Dock="Left" Content="🗑 Delete Rejected…" Command="{Binding DeleteAllRejectedCommand}" Margin="0,0,4,0" ToolTip="{Binding DeleteAllRejectedTooltip}" />

                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />

                <!-- View dropdown -->
                <Grid DockPanel.Dock="Left" Margin="0,0,8,0">
                    <ToggleButton x:Name="ViewToggleButton"
                                  IsChecked="{Binding IsOpen, ElementName=ViewPopup, Mode=TwoWay}"
                                  PreviewMouseLeftButtonDown="ViewToggleButton_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="ViewToggleButton_PreviewMouseLeftButtonUp"
                                  ToolTip="Show or hide the thumbnail grid and filmstrip panels">
                        View
                    </ToggleButton>
                    <Popup x:Name="ViewPopup"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ViewToggleButton}"
                           Closed="ViewPopup_Closed"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="PANELS" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6" />
                                <CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" Margin="0,0,0,4" />
                                <CheckBox Content="Filmstrip" IsChecked="{Binding ShowFilmstrip}"
                                          ToolTip="{Binding FilmstripToggleTooltip}" />
                                <Separator Margin="0,8,0,8" />
                                <TextBlock Text="MONITORS" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6" />
                                <CheckBox Content="Second-monitor preview"
                                          IsChecked="{Binding ShowSecondMonitor}"
                                          ToolTip="Open a borderless preview window on a second display. Filmstrip and tools stay on this monitor." />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Settings button -->
                <Button DockPanel.Dock="Right"
                        Content="⚙"
                        Click="Settings_Click"
                        Margin="0,0,4,0"
                        ToolTip="Settings" />

                <!-- Bulk linear-RAW cache: pre-decodes every RAW in the folder so
                     subsequent selections skip the ~1-3s libraw_unpack and read
                     from the disk cache instead. Click again to cancel. -->
                <Button DockPanel.Dock="Right"
                        Content="{Binding CacheAllButtonLabel}"
                        Command="{Binding CacheAllRawsCommand}"
                        Margin="0,0,4,0"
                        ToolTip="Pre-decode every RAW in this folder so navigation is instant. Runs in the background; click again to cancel." />

                <!-- Combined classification menu: one toolbar button opens a
                     dropdown to run closed-eye detection and/or subject
                     classification on demand. Each entry hides when its feature
                     is set to Off in Settings, and the whole button hides when
                     both are Off. While a pass runs, its entry doubles as the
                     cancel affordance. -->
                <Button DockPanel.Dock="Right"
                        x:Name="AnalyzeMenuButton"
                        Content="{Binding AnalyzeMenuButtonLabel}"
                        Click="AnalyzeMenu_Click"
                        Visibility="{Binding ShowAnalyzeMenu, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,4,0"
                        ToolTip="Run classification on this folder. Set Auto / Manual / Off per feature in Settings → Classification.">
                    <Button.ContextMenu>
                        <ContextMenu Closed="AnalyzeMenu_Closed">
                            <MenuItem Header="{Binding AnalyzeFacesButtonLabel}"
                                      Command="{Binding AnalyzeFacesCommand}"
                                      Visibility="{Binding IsClosedEyeDetectionEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="{Binding ClassifySubjectsButtonLabel}"
                                      Command="{Binding ClassifySubjectsCommand}"
                                      Visibility="{Binding IsSubjectClassificationEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Extractor indicator -->
                <Border DockPanel.Dock="Right"
                        Background="#33FFFFFF"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        ToolTip="Preview extractor in use. LibRaw = fast embedded JPEG; WIC = Windows codec (slower, needs Raw Image Extension)">
                    <TextBlock Text="{Binding ExtractorName}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                </Border>

                <!-- Right-aligned filter description -->
                <TextBlock DockPanel.Dock="Right" Margin="8,0" Foreground="{StaticResource TextDimBrush}">
                    <Run Text="Filter: " />
                    <Run Text="{Binding FilterDescription, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    <Run Text="    " />
                    <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" photos" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ================ MAIN SPLIT (sidebar + grid panel + preview + metadata) ================ -->
        <Grid x:Name="MainContentRow" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="400" />  <!-- Sidebar -->
                <ColumnDefinition Width="4" />                                    <!-- Splitter -->
                <ColumnDefinition Width="*" />                                    <!-- Existing main split -->
            </Grid.ColumnDefinitions>

            <!-- ────── LEFT SIDEBAR ────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,10,6,10"
                              PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel">
                    <StackPanel>

                        <!-- ── FOLDERS section ── -->
                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FOLDERS" Style="{StaticResource SectionCardHeader}" Margin="0" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="+"
                                    Command="{Binding CreateNewFolderCommand}"
                                    ToolTip="Create new folder"
                                    Width="20" Height="20"
                                    Padding="0" Margin="0"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextDimBrush}" />
                        </Grid>
                        <TreeView x:Name="FolderTreeView"
                                  ItemsSource="{Binding FolderTreeRoots}"
                                  Margin="0,0,0,4"
                                  Padding="0"
                                  MaxHeight="320"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="FolderTreeView_PreviewMouseRightButtonDown">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="New Folder"
                                                          Command="{Binding PlacementTarget.Tag.CreateNewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Rename"
                                                          Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Delete"
                                                          Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Copy Path"
                                                          Command="{Binding PlacementTarget.Tag.CopyFolderPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Open in File Explorer"
                                                          Command="{Binding PlacementTarget.Tag.OpenFolderInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="M 1.5,1 L 4.5,1 A 1,1 0 0 1 5.5,2 L 6.5,3 L 12.5,3 A 1,1 0 0 1 13.5,4 L 13.5,9 A 1,1 0 0 1 12.5,10 L 1.5,10 A 1,1 0 0 1 0.5,9 L 0.5,2 A 1,1 0 0 1 1.5,1 Z"
                                              StrokeThickness="1"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="11"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              SnapsToDevicePixels="True">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayedMediaCount}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DisplayedMediaCount, Converter={StaticResource NullToVisibility}}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Recursive (include subfolders) toggle. Sticky global
                             preference: applies to every folder open, persisted
                             in AppSettings.IncludeSubfolders. Disabled when the
                             currently open folder has no subfolders with media. -->
                        <CheckBox IsChecked="{Binding IsRecursiveView}"
                                  IsEnabled="{Binding HasSubfolderMedia}"
                                  Content="Include subfolders"
                                  FontSize="11"
                                  Foreground="{StaticResource TextDimBrush}"
                                  Margin="0,4,0,0"
                                  ToolTip="When on, the photo list shows every supported file in this folder and all its subfolders. Sticky global preference." />
                        </StackPanel>
                        </Border>

                        <!-- ── FILTERS section ── -->
                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <!-- Header row: section label + lock toggle. Locked (🔒) is
                             the normal state; clicking it (🔓) enters reorder mode,
                             where subsections can be dragged to a new order. Re-locking
                             persists the order to AppSettings.QuickFilterOrder. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUICK FILTERS"
                                       Style="{StaticResource SectionCardHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                            <ToggleButton x:Name="QuickFilterLockToggle" Grid.Column="1"
                                          Background="Transparent" BorderThickness="0" Padding="3"
                                          Cursor="Hand" Focusable="False" VerticalAlignment="Center"
                                          ToolTip="Locked - click to rearrange the filter order"
                                          Checked="QuickFilterLockToggle_Changed"
                                          Unchecked="QuickFilterLockToggle_Changed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Glyph" Text="&#x1F512;" FontSize="12"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#x1F513;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>

                        <!-- Reorderable container. Each direct child is one subsection
                             wrapper carrying a Tag key; drag-reorder + persistence are
                             handled in MainWindow.xaml.cs. -->
                        <StackPanel x:Name="QuickFilterSubsections" Background="Transparent"
                                    PreviewMouseLeftButtonDown="QuickFilterSubsections_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="QuickFilterSubsections_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="QuickFilterSubsections_PreviewMouseLeftButtonUp">

                        <!-- Rated subsection -->
                        <StackPanel Tag="Rated">
                        <ToggleButton x:Name="RatedToggle" Content="Rated"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsRatingSectionActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=RatedToggle, Converter={StaticResource BoolToVisibility}}">
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRating5Active}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>5</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★★★★★" Foreground="{StaticResource StarBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rating5Count}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRating4Active}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>4</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★★★★" Foreground="{StaticResource StarBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rating4Count}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRating3Active}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>3</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★★★" Foreground="{StaticResource StarBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rating3Count}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRating2Active}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>2</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★★" Foreground="{StaticResource StarBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rating2Count}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRating1Active}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>1</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★" Foreground="{StaticResource StarBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rating1Count}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetRatingBucketCommand}"
                                    IsActive="{Binding IsRatingUnratedActive}">
                                <controls:SidebarBucketButton.CommandParameter><sys:Int32>0</sys:Int32></controls:SidebarBucketButton.CommandParameter>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Unrated" Foreground="{StaticResource TextBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding RatingUnratedCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                        </StackPanel>
                        </StackPanel>

                        <!-- Flagged subsection -->
                        <StackPanel Tag="Flagged">
                        <ToggleButton x:Name="FlaggedToggle" Content="Flagged"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsFlagSectionActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=FlaggedToggle, Converter={StaticResource BoolToVisibility}}">
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarFlagCommand}" CommandParameter="{x:Static models:CullFlag.Pick}"
                                    IsActive="{Binding IsFlagPickActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="10" Height="12"
                                          Data="M 1,1 L 9,1 L 7,3 L 9,5 L 2,5 L 2,11 L 1,11 Z"
                                          Fill="{StaticResource PickBrush}"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="Picks" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding FlagPickCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarFlagCommand}" CommandParameter="{x:Static models:CullFlag.Reject}"
                                    IsActive="{Binding IsFlagRejectActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="10" Height="12"
                                          Data="M 1,1 L 9,1 L 7,3 L 9,5 L 2,5 L 2,11 L 1,11 Z"
                                          Fill="{StaticResource RejectBrush}"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="Rejected" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding FlagRejectCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarFlagCommand}" CommandParameter="{x:Static models:CullFlag.Unflagged}"
                                    IsActive="{Binding IsFlagUnflaggedActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="10" Height="12"
                                          Data="M 1,1 L 9,1 L 7,3 L 9,5 L 2,5 L 2,11 L 1,11 Z"
                                          Stroke="{StaticResource TextDimBrush}"
                                          StrokeThickness="1"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="Unflagged" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding FlagUnflaggedCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                        </StackPanel>
                        </StackPanel>

                        <!-- Exposure subsection — flags photos whose clipped/crushed area
                             exceeds the threshold set in Settings → Clipping. Icons are
                             directional triangles pointing at the rail (right = upper rail,
                             left = lower rail) so they read as "pixels pushed past the edge"
                             rather than being mistaken for color labels. -->
                        <StackPanel Tag="Exposure">
                        <ToggleButton x:Name="ExposureToggle" Content="Exposure"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsExposureSectionActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=ExposureToggle, Converter={StaticResource BoolToVisibility}}">
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarExposureCommand}"
                                    CommandParameter="{x:Static vm:ExposureFilterMode.ClippedHighlights}"
                                    IsActive="{Binding IsExposureClippedHighlightsActive}"
                                    ToolTip="Photos with a high share of clipped highlight pixels">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="10" Height="10"
                                          Data="M 1,1 L 9,5 L 1,9 Z"
                                          Fill="#FFE53935"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="Clipped highlights" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClippedHighlightsCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarExposureCommand}"
                                    CommandParameter="{x:Static vm:ExposureFilterMode.CrushedShadows}"
                                    IsActive="{Binding IsExposureCrushedShadowsActive}"
                                    ToolTip="Photos with a high share of crushed shadow pixels">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="10" Height="10"
                                          Data="M 9,1 L 1,5 L 9,9 Z"
                                          Fill="#FF2196F3"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="Crushed shadows" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding CrushedShadowsCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                        </StackPanel>
                        </StackPanel>

                        <!-- Subjects subsection — populated by the auto-running
                             zero-shot CLIP classifier after folder open. Built
                             from the SubjectGroups taxonomy: each group root is a
                             chip whose count is the union of its leaves; groups
                             with leaves expand to reveal them. Chips are
                             single-select — clicking one filters to exactly that
                             category and clears any other; clicking it again
                             clears the filter. Unclassified photos stay out of
                             both sides of the include/exclude split. -->
                        <StackPanel Tag="Subjects">
                        <!-- Tag carries the section-active flag; the base style's
                             template rolls the blue cue onto the header when the
                             section is collapsed while a subject filter is active. -->
                        <ToggleButton x:Name="SubjectsToggle" Content="Subjects" IsChecked="True"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsSubjectFilterActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=SubjectsToggle, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel.Resources>
                                <!-- Compact chevron toggle that flips ▸/▾ with IsExpanded. -->
                                <Style x:Key="SubjectExpanderToggle" TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock x:Name="Arrow" Text="▸" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Text" Value="▾" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <ItemsControl ItemsSource="{Binding SubjectGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Group header: expander (only when the group has leaves) + the group chip. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource SubjectExpanderToggle}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Visibility="{Binding HasLeaves, Converter={StaticResource BoolToVisibility}}"
                                                              ToolTip="Show / hide sub-categories" />
                                                <controls:SidebarBucketButton Grid.Column="1"
                                                        Style="{StaticResource SidebarBucketStyle}"
                                                        Command="{Binding DataContext.SetSidebarSubjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Tag}"
                                                        IsActive="{Binding ShowActiveCue}"
                                                        ToolTip="Filter to photos the classifier tagged in this category">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" />
                                                    </Grid>
                                                </controls:SidebarBucketButton>
                                            </Grid>
                                            <!-- Leaf chips, indented; visible only while the group is expanded. -->
                                            <ItemsControl ItemsSource="{Binding Leaves}" Margin="20,0,0,0"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                                                Command="{Binding DataContext.SetSidebarSubjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Tag}"
                                                                IsActive="{Binding IsActive}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" />
                                                            </Grid>
                                                        </controls:SidebarBucketButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </StackPanel>

                        <!-- Faces subsection — populated by the toolbar 👁 button.
                             Threshold lives in Settings → Faces. Photos that
                             haven't been analysed yet don't appear in either side
                             of the chip's include/exclude split. -->
                        <StackPanel Tag="Faces">
                        <ToggleButton x:Name="FacesToggle" Content="Faces"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsFaceSectionActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=FacesToggle, Converter={StaticResource BoolToVisibility}}">
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarFaceCommand}"
                                    CommandParameter="{x:Static vm:FaceFilterMode.ClosedEyes}"
                                    IsActive="{Binding IsFaceClosedEyesActive}"
                                    ToolTip="Photos where face / closed-eye analysis flagged at least one closed eye">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="👁"
                                               FontSize="11"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Closed eyes" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClosedEyesCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                        </StackPanel>
                        </StackPanel>

                        <!-- Labelled subsection — least frequently used, parked at the bottom. -->
                        <StackPanel Tag="Labelled">
                        <ToggleButton x:Name="LabelledToggle" Content="Labelled"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsLabelSectionActive}" />
                        <StackPanel Margin="6,0,6,4"
                                    Visibility="{Binding IsChecked, ElementName=LabelledToggle, Converter={StaticResource BoolToVisibility}}">
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarColorLabelCommand}" CommandParameter="{x:Static models:ColorLabel.Red}"
                                    IsActive="{Binding IsLabelRedActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FFE53935" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Red" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding LabelRedCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarColorLabelCommand}" CommandParameter="{x:Static models:ColorLabel.Yellow}"
                                    IsActive="{Binding IsLabelYellowActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FFFFC107" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Yellow" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding LabelYellowCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarColorLabelCommand}" CommandParameter="{x:Static models:ColorLabel.Green}"
                                    IsActive="{Binding IsLabelGreenActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FF4CAF50" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Green" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding LabelGreenCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarColorLabelCommand}" CommandParameter="{x:Static models:ColorLabel.Blue}"
                                    IsActive="{Binding IsLabelBlueActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FF2196F3" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Blue" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding LabelBlueCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                            <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                    Command="{Binding SetSidebarColorLabelCommand}" CommandParameter="{x:Static models:ColorLabel.Purple}"
                                    IsActive="{Binding IsLabelPurpleActive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#FF9C27B0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Purple" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding LabelPurpleCount}" FontSize="11" />
                                </Grid>
                            </controls:SidebarBucketButton>
                        </StackPanel>
                        </StackPanel>

                        <!-- ── TAGS subsection ── -->
                        <StackPanel Tag="Tags">
                        <ToggleButton x:Name="TagsToggle" Content="Tags"
                                      Style="{StaticResource SidebarSubsectionToggle}"
                                      Tag="{Binding IsTagSectionActive}" />
                        <ItemsControl x:Name="SidebarTagsList" ItemsSource="{Binding Tags}" Margin="6,0,6,4"
                                      Visibility="{Binding IsChecked, ElementName=TagsToggle, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:SidebarBucketButton Style="{StaticResource SidebarBucketStyle}"
                                            Command="{Binding DataContext.SetSidebarTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <controls:SidebarBucketButton.IsActive>
                                            <!-- SetContains, not Equality: shift-click adds extras to
                                                 TagFilterActiveIds, so every selected tag must light up,
                                                 not just the TagFilter anchor. -->
                                            <MultiBinding Converter="{StaticResource SetContains}">
                                                <Binding Path="DataContext.TagFilterActiveIds" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </controls:SidebarBucketButton.IsActive>
                                        <controls:SidebarBucketButton.Content>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" />
                                            </Grid>
                                        </controls:SidebarBucketButton.Content>
                                    </controls:SidebarBucketButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        </StackPanel>

                        <!-- Combine-filters hint, parked at the bottom of the quick filters. -->
                        <TextBlock Text="Tip: Shift-click to combine filters"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="6,10,6,2" />
                        </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter between sidebar and main split -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE" />

        <Grid x:Name="MainSplitGrid" Grid.Column="2" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="100" MaxWidth="500" />  <!-- Grid panel -->
                <ColumnDefinition Width="4" />                                   <!-- Splitter -->
                <ColumnDefinition Width="*" />                                   <!-- Preview -->
                <ColumnDefinition Width="Auto" />                                <!-- Metadata -->
            </Grid.ColumnDefinitions>

            <!-- ── Grid panel ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgFilmstripBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,0">
                <DockPanel>
                    <!-- Header: label + zoom slider -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource BgToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <TextBlock Text="GRID"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,8,0" />
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding IsGridExpanded}"
                                          Margin="6,0,0,0"
                                          Padding="6,1"
                                          FontSize="12"
                                          MinWidth="0"
                                          ToolTip="{Binding GridExpandedToggleTooltip}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="⇥" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="⇤" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- Date segmentation toggle: groups the grid into
                                 calendar-day sections. Sticky global preference;
                                 only changes the view when sorted by capture date. -->
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding ShowDateHeaders}"
                                          Margin="6,0,0,0"
                                          Padding="6,1"
                                          FontSize="12"
                                          MinWidth="0"
                                          Content="&#x1F5D3;"
                                          ToolTip="Group the grid into date sections (applies when sorted by capture date)">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="+"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       Margin="4,0,0,0" />
                            <TextBlock Text="−"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,4,0" />
                            <Slider Minimum="1"
                                    Maximum="{Binding MaxGridColumnCount}"
                                    Value="{Binding ActiveGridColumnCount}"
                                    IsDirectionReversed="True"
                                    VerticalAlignment="Center"
                                    SmallChange="1"
                                    LargeChange="1" />
                        </DockPanel>
                    </Border>

                    <!-- Thumbnail grid -->
                    <ListBox x:Name="GridView"
                             SizeChanged="GridView_SizeChanged"
                             ItemsSource="{Binding GridItems}"
                             SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
                             SelectionChanged="GridView_SelectionChanged"
                             PreviewMouseWheel="GridView_PreviewMouseWheel"
                             PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="PhotoList_PreviewMouseRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <Style x:Key="GridHeaderItemStyle" TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <DataTemplate x:Key="GridHeaderTemplate">
                                <Grid Margin="6,4,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="2,0,10,0" />
                                    <Rectangle Grid.Column="1"
                                               Height="1"
                                               VerticalAlignment="Center"
                                               Fill="{StaticResource BorderBrush}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate x:Key="GridPhotoTemplate" DataType="{x:Type models:PhotoItem}">
                                <StackPanel Width="{Binding DataContext.GridThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{Binding DataContext.GridCellHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Tags"
                                                      ItemsSource="{Binding PlacementTarget.Tag.SelectedPhotoTagAssignments, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding Tag.Name}" />
                                                        <Setter Property="IsCheckable" Value="True" />
                                                        <Setter Property="IsChecked" Value="{Binding IsAssigned, Mode=OneWay}" />
                                                        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.ToggleTagForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding Tag}" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="New Tag…"
                                                      Command="{Binding PlacementTarget.Tag.CreateTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Clear assigned metadata">
                                                <MenuItem Header="Selected photos..."
                                                          Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="All photos..."
                                                          Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Delete…"
                                                      InputGestureText="{Binding PlacementTarget.Tag.DeletePhotoShortcutDisplay, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding PlacementTarget.Tag.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Grid Height="{Binding DataContext.GridThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <!-- Stack-of-cards backers: same-sized cards offset diagonally behind main -->
                                        <Border Background="{StaticResource BurstStackBack1Brush}"
                                                BorderBrush="{StaticResource BurstStackBackBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                                Margin="0,0,8,8"
                                                Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" />
                                        <Border Background="{StaticResource BurstStackBack2Brush}"
                                                BorderBrush="{StaticResource BurstStackBackBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                                Margin="4,4,4,4"
                                                Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" />

                                        <Border x:Name="thumbCard"
                                                Background="#FF0E0E0E"
                                                CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                                MouseLeftButtonUp="GridItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                                        <Setter Property="Margin" Value="8,8,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding ThumbnailJpeg, Converter={StaticResource ThumbBytesToImage}}"
                                                   Stretch="UniformToFill"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="LowQuality"
                                                   ClipToBounds="True" />
                                            <Rectangle Width="3"
                                                       HorizontalAlignment="Left"
                                                       Fill="{Binding Flag, Converter={StaticResource FlagToBrush}}" />
                                            <Ellipse Width="8" Height="8"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,4,4,0"
                                                     Fill="{Binding ColorLabel, Converter={StaticResource LabelToBrush}}" />
                                            <!-- Always-visible burst indicator: shows the stack-of-cards icon
                                                 whenever the photo is part of a burst group (GroupId > 0). -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#A0000000"
                                                    Padding="3,0" Margin="0,16,4,0"
                                                    CornerRadius="2"
                                                    ToolTip="Part of a burst group"
                                                    Visibility="{Binding GroupId, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="&#x29C9;"
                                                           Foreground="White"
                                                           FontSize="11" />
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Background="#A0000000"
                                                    Padding="4,1" Margin="2"
                                                    CornerRadius="2"
                                                    Visibility="{Binding Rating, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStars}}"
                                                           Foreground="{StaticResource StarBrush}"
                                                           FontSize="10" />
                                            </Border>
                                            <!-- Tag indicators (system tags stacked above user tags) -->
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="2" Orientation="Vertical">
                                                <Border Background="#CCFF7A00"
                                                        Padding="4,1" Margin="0,0,0,2"
                                                        CornerRadius="2"
                                                        ToolTip="HDR / auto-bracket"
                                                        Visibility="{Binding IsHdr, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="HDR"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#CC00B8B8"
                                                        Padding="4,1" Margin="0,0,0,2"
                                                        CornerRadius="2"
                                                        ToolTip="Panorama"
                                                        Visibility="{Binding IsPanorama, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="PANO"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#CC3B82F6"
                                                        Padding="4,1"
                                                        CornerRadius="2"
                                                        Visibility="{Binding TagDisplay, Converter={StaticResource NullToVisibility}}">
                                                    <TextBlock Text="{Binding TagDisplay}"
                                                               Foreground="White"
                                                               FontSize="9" />
                                                </Border>
                                            </StackPanel>
                                            <!-- Burst position badge: only shown when expanded -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{DynamicResource BurstLabelBrush}"
                                                    Padding="4,1" Margin="6,4,0,0"
                                                    CornerRadius="2"
                                                    ToolTip="Part of a burst group">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding CollapsedBurstCount}" Value="0" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="{Binding BurstBadge, Converter={StaticResource NullToVisibility}}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x29C9;"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding BurstBadge}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Collapsed-burst count badge: only when collapsed -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="#CC1A1A1A"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Padding="6,2" Margin="6,6,0,0"
                                                    CornerRadius="4"
                                                    ToolTip="Burst - double-click to focus"
                                                    Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x29C9;"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding CollapsedBurstCount, Mode=OneWay}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Video indicator -->
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Background="#CC000000"
                                                    Padding="4,1" Margin="0,0,0,2"
                                                    CornerRadius="2"
                                                    ToolTip="Video"
                                                    Visibility="{Binding IsVideo, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="▶" Foreground="White" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="2,2,2,0"
                                               Visibility="{Binding DataContext.GridFilenameVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyleSelector>
                            <controls:GridItemContainerStyleSelector
                                PhotoStyle="{StaticResource FilmstripItemStyle}"
                                HeaderStyle="{StaticResource GridHeaderItemStyle}" />
                        </ListBox.ItemContainerStyleSelector>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel
                                    ItemWidth="{Binding DataContext.GridItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    ItemHeight="{Binding DataContext.GridItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    FullWidthItemHeight="28" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplateSelector>
                            <controls:GridItemTemplateSelector
                                PhotoTemplate="{StaticResource GridPhotoTemplate}"
                                HeaderTemplate="{StaticResource GridHeaderTemplate}" />
                        </ListBox.ItemTemplateSelector>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE" />

            <!-- Preview area -->
            <Grid x:Name="PreviewColumnGrid" Grid.Column="2" Background="#FF0E0E0E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        x:Name="PreviewHost"
                        Background="Transparent"
                        ClipToBounds="True"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        MouseWheel="PreviewHost_MouseWheel"
                        MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
                        MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp"
                        PreviewMouseLeftButtonUp="PreviewHost_PreviewMouseLeftButtonUp"
                        MouseMove="PreviewHost_MouseMove">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Tags"
                                      ItemsSource="{Binding PlacementTarget.Tag.SelectedPhotoTagAssignments, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Tag.Name}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsAssigned, Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.ToggleTagForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding Tag}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="New Tag…"
                                      Command="{Binding PlacementTarget.Tag.CreateTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Clear assigned metadata">
                                <MenuItem Header="Selected photos..."
                                          Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="All photos..."
                                          Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete…"
                                      InputGestureText="{Binding PlacementTarget.Tag.DeletePhotoShortcutDisplay, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Command="{Binding PlacementTarget.Tag.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid x:Name="PreviewImageGrid"
                          SizeChanged="PreviewImageGrid_SizeChanged">
                        <!-- Burst stack-of-cards backers. Sized and positioned in
                             code-behind (UpdateBurstStackFrame) to hug the letterboxed
                             photo and peek out top + right, so a burst group reads as a
                             stack even when the small "BURST" badge is easy to miss.
                             Only the top + right edges are drawn (BorderThickness
                             "0,t,t,0") so the lines simply end rather than crossing at
                             the other corners. Card2 sits farthest back; both are
                             hidden when zoomed. -->
                        <Border x:Name="BurstStackCard2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderBrush="{StaticResource BurstPreviewStackOutlineBrush}"
                                BorderThickness="0,1.5,1.5,0"
                                CornerRadius="0,3,0,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Border x:Name="BurstStackCard1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderBrush="{StaticResource BurstPreviewStackOutlineBrush}"
                                BorderThickness="0,1.5,1.5,0"
                                CornerRadius="0,3,0,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Image x:Name="PreviewImageElement"
                               Source="{Binding PreviewImage, NotifyOnTargetUpdated=True}"
                               Binding.TargetUpdated="PreviewImageElement_TargetUpdated"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8,16,8,8"
                               RenderTransformOrigin="0,0"
                               Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <flyleaf:FlyleafHost x:Name="VideoPlayer"
                                             Margin="8,16,8,8"
                                             Background="Black"
                                             Visibility="Collapsed"
                                             MouseBindings="None"
                                             KeyBindings="None"
                                             ToggleFullScreenOnDoubleClick="None"
                                             BringToFrontOnClick="False"
                                             AttachedDragMove="None"
                                             PanMoveOnCtrl="None"
                                             PanZoomOnCtrlWheel="None"
                                             PanRotateOnShiftWheel="None" />

                        <!-- Focus Peaking overlay — shares transforms with PreviewImageElement via binding -->
                        <Image x:Name="FocusPeakingOverlayImage"
                               Source="{Binding FocusPeakingOverlay}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8,16,8,8"
                               RenderTransformOrigin="0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding FocusPeakingEnabled, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScale}"
                                                    ScaleY="{Binding ScaleY, ElementName=PreviewScale}" />
                                    <TranslateTransform X="{Binding X, ElementName=PreviewTranslate}"
                                                        Y="{Binding Y, ElementName=PreviewTranslate}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Clipping warning overlay — red highlights / blue shadows on the linear RAW -->
                        <Image x:Name="ClippingOverlayImage"
                               Source="{Binding ClippingOverlay}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8,16,8,8"
                               RenderTransformOrigin="0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding ClippingEnabled, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScale}"
                                                    ScaleY="{Binding ScaleY, ElementName=PreviewScale}" />
                                    <TranslateTransform X="{Binding X, ElementName=PreviewTranslate}"
                                                        Y="{Binding Y, ElementName=PreviewTranslate}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Detected-face boxes (debug). Shares the preview transform
                             so boxes track zoom/pan; green = eyes open, orange = closed eye. -->
                        <Image x:Name="FaceDebugOverlayImage"
                               Source="{Binding FaceDebugOverlay}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               Margin="8,16,8,8"
                               RenderTransformOrigin="0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding FaceDebugOverlay, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScale}"
                                                    ScaleY="{Binding ScaleY, ElementName=PreviewScale}" />
                                    <TranslateTransform X="{Binding X, ElementName=PreviewTranslate}"
                                                        Y="{Binding Y, ElementName=PreviewTranslate}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Subject-classifier score HUD (Settings → General → Debug).
                             A fixed top-left overlay (does not zoom/pan with the photo),
                             shown only when SubjectDebugText is non-null. Top margin
                             clears the "BURST" badge (Margin 16 + ~39px tall) that sits
                             at the top-left of the preview for burst photos. -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="16,64,0,0"
                                Background="#C8000000"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6"
                                IsHitTestVisible="False"
                                Visibility="{Binding SubjectDebugText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SubjectDebugText}"
                                       Foreground="#FFE6E6E6"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="NoWrap" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Empty-state overlay -->
                <TextBlock Text="{Binding EmptyStateMessage}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding SelectedPhoto, Converter={StaticResource NotNullToCollapsed}}" />

                <!-- Loading indicator -->
                <Border Background="#A0000000"
                        Padding="16,10"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsLoading, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="Loading…" Foreground="{StaticResource TextBrush}" />
                </Border>

                <!-- Smooth-preview proxy generation indicator. Replaces the choppy
                     direct playback of high-bitrate HEVC (4K 4:2:2 etc.) with the
                     still preview JPEG while ffmpeg builds a downscaled proxy. -->
                <Border Background="#A0000000"
                        Padding="16,10"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsPreparingVideoProxy, Converter={StaticResource NullToVisibility}}">
                    <StackPanel MinWidth="260">
                        <TextBlock Text="{Binding VideoProxyProgressText}"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding VideoProxyProgress, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                    <Style.Triggers>
                                        <!-- VideoProxyProgress is -1 until ffmpeg
                                             emits its first out_time_us frame. -->
                                        <DataTrigger Binding="{Binding VideoProxyProgress}" Value="-1">
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- Star rating + tag overlays (top-right of preview) -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding SelectedPhoto, Converter={StaticResource NullToVisibility}}">
                    <Border Background="#80000000"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4">
                        <TextBlock Text="{Binding SelectedPhoto.Rating, Converter={StaticResource RatingToStars}}"
                                   Foreground="{StaticResource StarBrush}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#CCFF7A00"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4"
                            ToolTip="HDR / auto-bracket"
                            Visibility="{Binding SelectedPhoto.IsHdr, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="HDR"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#CC00B8B8"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4"
                            ToolTip="Panorama"
                            Visibility="{Binding SelectedPhoto.IsPanorama, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PANO"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#CC3B82F6"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4"
                            Visibility="{Binding SelectedPhoto.TagDisplay, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedPhoto.TagDisplay}"
                                   Foreground="White"
                                   FontSize="12" />
                    </Border>
                    <!-- RAW / JPG file-kind indicator. Hidden for video. -->
                    <Border Background="#80000000"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4"
                            ToolTip="{Binding SelectedPhoto.Extension}"
                            Visibility="{Binding SelectedPhoto.FileTypeBadge, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedPhoto.FileTypeBadge}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Burst-group indicator (top-left of preview) — stack-of-cards
                     icon, "BURST" label and this photo's position in the burst
                     (e.g. "2/5"). Shown in both the normal and fullscreen preview;
                     background colour is the user-customisable BurstLabelBrush. -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource BurstLabelBrush}"
                        Padding="10,5"
                        CornerRadius="3"
                        Margin="16,16,0,0"
                        IsHitTestVisible="False"
                        ToolTip="Part of a burst group"
                        Visibility="{Binding SelectedPhoto.GroupId, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x29C9;"
                                   Foreground="White"
                                   FontSize="{StaticResource BurstBadgeFontSize}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="BURST"
                                   Foreground="White"
                                   FontSize="{StaticResource BurstBadgeFontSize}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding SelectedPhoto.BurstBadge}"
                                   Foreground="White"
                                   FontSize="{StaticResource BurstBadgeFontSize}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Fullscreen-only preview badges. These sit above the normal
                     overlays so the preview source is obvious while all the
                     surrounding chrome is hidden. (The burst indicator above is
                     shared with the normal preview, so there's no fullscreen-only
                     burst badge here.) The top margin drops to clear the shared
                     burst indicator only when a burst is present, so the source
                     badge hugs the top-left for ordinary photos. -->
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="16,16,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPhoto.GroupId, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                    <Setter Property="Margin" Value="16,58,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="#E6000000"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Padding="10,4"
                            CornerRadius="3"
                            ToolTip="Current fullscreen preview source">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPhotoFullscreen}" Value="True" />
                                            <Condition Binding="{Binding FullscreenPreviewSourceLabel, Converter={StaticResource NullToVisibility}}" Value="Visible" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FullscreenPreviewSourceLabel}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Focus peaking indicator (bottom-left) -->
                <Border Grid.Row="0"
                        Background="#CC1E40AF"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,16"
                        IsHitTestVisible="False"
                        Visibility="{Binding FocusPeakingEnabled, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="FOCUS PEAK"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <!-- Clipping indicator (bottom-left) -->
                <Border Grid.Row="0"
                        Background="#CC991B1B"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,16"
                        IsHitTestVisible="False"
                        Visibility="{Binding ClippingEnabled, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="CLIPPING"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <!-- Zoom indicator (bottom-right) -->
                <Border Grid.Row="0"
                        Background="#80000000"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        IsHitTestVisible="False"
                        x:Name="ZoomIndicator"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ZoomIndicatorText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="11" />
                </Border>

                <!-- "Show filmstrip" pull-tab (bottom-centre), fullscreen only. The
                     windowed view carries the same toggle in the status bar, but that
                     bar is collapsed while immersed — so this pointer-only affordance
                     brings the strip back in fullscreen (mirrors F6). -->
                <Button Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10"
                        Height="20" Padding="16,0"
                        FontSize="11"
                        Content="&#x25B2;"
                        Command="{Binding ToggleFilmstripCommand}"
                        ToolTip="Show the filmstrip (F6)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0.85" />
                            <Style.Triggers>
                                <!-- Fullscreen view: fullscreen filmstrip hidden. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPhotoFullscreen}" Value="True" />
                                        <Condition Binding="{Binding ShowFilmstripFullscreen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Exposure compensation slider (visible only for photos) -->
                <Border x:Name="ExposureCompensationBar"
                        Grid.Row="1"
                        Background="{StaticResource BgToolbarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        Visibility="{Binding VideoSourceUri, Converter={StaticResource NotNullToCollapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ExposureSourceLabel}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="11" />
                        <Slider x:Name="ExposureSlider"
                                Grid.Column="1"
                                Style="{StaticResource ExposureSliderStyle}"
                                Minimum="-5"
                                Maximum="5"
                                Value="{Binding ExposureCompensation}"
                                SmallChange="0.3333333333333333"
                                LargeChange="1.0"
                                TickFrequency="0.3333333333333333"
                                IsSnapToTickEnabled="True"
                                IsSelectionRangeEnabled="True"
                                SelectionStart="{Binding ExposureSelectionStart, Mode=OneWay}"
                                SelectionEnd="{Binding ExposureSelectionEnd, Mode=OneWay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                MouseDoubleClick="ExposureSlider_MouseDoubleClick" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ExposureCompensation, StringFormat='{}{0:+0.00;-0.00;0.00}'}"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Width="42"
                                   TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Video playback controls (visible only when a video is loaded) -->
                <Border Grid.Row="1"
                        Background="{StaticResource BgToolbarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        Visibility="{Binding VideoSourceUri, Converter={StaticResource NullToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="VideoPlayPauseButton"
                                DockPanel.Dock="Left"
                                Content="▶"
                                Width="32"
                                Margin="0,0,8,0"
                                Click="VideoPlayPause_Click"
                                ToolTip="Play / Pause (Space)" />
                        <TextBlock x:Name="VideoTimeText"
                                   DockPanel.Dock="Right"
                                   Text="0:00 / 0:00"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontFamily="Consolas" />
                        <Button x:Name="VideoMuteButton"
                                DockPanel.Dock="Right"
                                Content="🔊"
                                Width="32"
                                Margin="8,0,0,0"
                                Click="VideoMute_Click"
                                ToolTip="{Binding VideoMuteTooltip}" />
                        <ComboBox x:Name="VideoSpeedBox"
                                  DockPanel.Dock="Right"
                                  Width="72"
                                  Margin="8,0,0,0"
                                  SelectedIndex="2"
                                  SelectionChanged="VideoSpeedBox_SelectionChanged"
                                  ToolTip="Playback speed">
                            <ComboBoxItem Content="0.25x" Tag="0.25" />
                            <ComboBoxItem Content="0.5x" Tag="0.5" />
                            <ComboBoxItem Content="1x" Tag="1" />
                            <ComboBoxItem Content="1.5x" Tag="1.5" />
                            <ComboBoxItem Content="2x" Tag="2" />
                            <ComboBoxItem Content="3x" Tag="3" />
                            <ComboBoxItem Content="4x" Tag="4" />
                        </ComboBox>
                        <Slider x:Name="VideoSlider"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                Thumb.DragStarted="VideoSlider_DragStarted"
                                Thumb.DragCompleted="VideoSlider_DragCompleted"
                                ValueChanged="VideoSlider_ValueChanged" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Metadata panel -->
            <controls:PhotoInfoPanel x:Name="PhotoInfoPanelControl"
                                     Grid.Column="3"
                                     Photo="{Binding SelectedPhoto}"
                                     CaptureDateText="{Binding SelectedPhotoCaptureDateFormatted}"
                                     HistogramData="{Binding HistogramData}"
                                     HistogramMode="{Binding HistogramMode}"
                                     SidePanelView="{Binding SidePanelView}"
                                     SetSidePanelViewCommand="{Binding SetSidePanelViewCommand}"
                                     SetHistogramModeCommand="{Binding SetHistogramModeCommand}" />
        </Grid>
        </Grid>

        <!-- ================ FILMSTRIP SPLITTER ================ -->
        <GridSplitter Grid.Row="2"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource BorderBrush}"
                      Cursor="SizeNS"
                      ToolTip="Drag to resize the filmstrip - double-click to hide it (F6)"
                      PreviewMouseLeftButtonDown="FilmstripSplitter_PreviewMouseLeftButtonDown" />

        <!-- ================ FILMSTRIP ================ -->
        <Border Grid.Row="3"
                Background="{StaticResource BgFilmstripBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1">
            <Grid>
            <ListBox x:Name="Filmstrip"
                     ItemsSource="{Binding FilteredPhotos}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource FilmstripItemStyle}"
                     SelectionChanged="Filmstrip_SelectionChanged"
                     PreviewKeyDown="Filmstrip_PreviewKeyDown"
                     PreviewMouseWheel="Filmstrip_PreviewMouseWheel"
                     PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="PhotoList_PreviewMouseRightButtonDown"
                     SizeChanged="Filmstrip_SizeChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PhotoItem}">
                        <Grid Width="{Binding DataContext.FilmstripItemWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Tags"
                                              ItemsSource="{Binding PlacementTarget.Tag.SelectedPhotoTagAssignments, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Tag.Name}" />
                                                <Setter Property="IsCheckable" Value="True" />
                                                <Setter Property="IsChecked" Value="{Binding IsAssigned, Mode=OneWay}" />
                                                <Setter Property="Command" Value="{Binding PlacementTarget.Tag.ToggleTagForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Tag}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="New Tag…"
                                              Command="{Binding PlacementTarget.Tag.CreateTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Clear assigned metadata">
                                        <MenuItem Header="Selected photos..."
                                                  Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="All photos..."
                                                  Command="{Binding PlacementTarget.Tag.ClearAssignedMetadataForAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Delete…"
                                              InputGestureText="{Binding PlacementTarget.Tag.DeletePhotoShortcutDisplay, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Thumbnail area -->
                            <Grid Grid.Row="0">
                                <!-- Stack-of-cards backers: same-sized cards offset diagonally behind main -->
                                <Border Background="{StaticResource BurstStackBack1Brush}"
                                        BorderBrush="{StaticResource BurstStackBackBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" />
                                <Border Background="{StaticResource BurstStackBack2Brush}"
                                        BorderBrush="{StaticResource BurstStackBackBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                        Margin="4,4,4,4"
                                        Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" />
                            <Border x:Name="thumbCard"
                                    Background="#FF0E0E0E"
                                    CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                    MouseLeftButtonUp="FilmstripItem_MouseLeftButtonUp">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Background="Black"
                                                    CornerRadius="{StaticResource ThumbnailCornerRadius}"
                                                    Width="{Binding ActualWidth, ElementName=thumbCard}"
                                                    Height="{Binding ActualHeight, ElementName=thumbCard}" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                                <Setter Property="Margin" Value="8,8,0,0" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.45" Color="Black" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding ThumbnailJpeg, Converter={StaticResource ThumbBytesToImage}}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="LowQuality" />

                                    <!-- Flag bar (left edge) -->
                                    <Rectangle Width="3"
                                               HorizontalAlignment="Left"
                                               Fill="{Binding Flag, Converter={StaticResource FlagToBrush}}" />

                                    <!-- Color label dot (top-right) -->
                                    <Ellipse Width="8" Height="8"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,4,4,0"
                                             Fill="{Binding ColorLabel, Converter={StaticResource LabelToBrush}}" />
                                    <!-- Always-visible burst indicator: shows the stack-of-cards icon
                                         whenever the photo is part of a burst group (GroupId > 0). -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#A0000000"
                                            Padding="3,0" Margin="0,16,4,0"
                                            CornerRadius="2"
                                            ToolTip="Part of a burst group"
                                            Visibility="{Binding GroupId, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="&#x29C9;"
                                                   Foreground="White"
                                                   FontSize="11" />
                                    </Border>

                                    <!-- Stars (bottom-left) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="#A0000000"
                                            Padding="4,1" Margin="2"
                                            CornerRadius="2"
                                            Visibility="{Binding Rating, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStars}}"
                                                   Foreground="{StaticResource StarBrush}"
                                                   FontSize="10" />
                                    </Border>
                                    <!-- Tag indicators (bottom-right): system tags stacked above user tags -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="2" Orientation="Vertical">
                                        <Border Background="#CCFF7A00"
                                                Padding="4,1" Margin="0,0,0,2"
                                                CornerRadius="2"
                                                ToolTip="HDR / auto-bracket"
                                                Visibility="{Binding IsHdr, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="HDR"
                                                       Foreground="White"
                                                       FontSize="9"
                                                       FontWeight="Bold" />
                                        </Border>
                                        <Border Background="#CC00B8B8"
                                                Padding="4,1" Margin="0,0,0,2"
                                                CornerRadius="2"
                                                ToolTip="Panorama"
                                                Visibility="{Binding IsPanorama, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="PANO"
                                                       Foreground="White"
                                                       FontSize="9"
                                                       FontWeight="Bold" />
                                        </Border>
                                        <Border Background="#CC3B82F6"
                                                Padding="4,1"
                                                CornerRadius="2"
                                                Visibility="{Binding TagDisplay, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding TagDisplay}"
                                                       Foreground="White"
                                                       FontSize="9" />
                                        </Border>
                                    </StackPanel>
                                    <!-- Burst position badge: only shown when expanded -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource BurstLabelBrush}"
                                            Padding="4,1" Margin="6,4,0,0"
                                            CornerRadius="2"
                                            ToolTip="Part of a burst group">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CollapsedBurstCount}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="{Binding BurstBadge, Converter={StaticResource NullToVisibility}}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x29C9;"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding BurstBadge}"
                                                       Foreground="White"
                                                       FontSize="9"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Collapsed-burst count badge: only when collapsed -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="#CC1A1A1A"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1"
                                            Padding="6,2" Margin="6,6,0,0"
                                            CornerRadius="4"
                                            ToolTip="Burst - double-click to focus"
                                            Visibility="{Binding CollapsedBurstCount, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x29C9;"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding CollapsedBurstCount, Mode=OneWay}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Video indicator -->
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Background="#CC000000"
                                            Padding="4,1" Margin="0,0,0,2"
                                            CornerRadius="2"
                                            ToolTip="Video"
                                            Visibility="{Binding IsVideo, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="▶" Foreground="White" FontSize="9" />
                                    </Border>
                                </Grid>
                            </Border>
                            </Grid>

                            <!-- Filename -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding FileName}"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="2,2,2,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Fullscreen-only "close filmstrip" button. Outside fullscreen the
                 View popup carries the Filmstrip toggle, but that popup is hidden
                 while immersed, so this gives a pointer-only way to dismiss the
                 strip (mirrors the F6 shortcut and the splitter double-click). -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,6,0"
                    Width="22" Height="22"
                    Padding="0"
                    FontSize="12"
                    Content="&#x2715;"
                    Command="{Binding ToggleFilmstripCommand}"
                    ToolTip="Hide the filmstrip (F6)"
                    Visibility="{Binding IsPhotoFullscreen, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ================ STATUS BAR ================ -->
        <Border Grid.Row="4"
                Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CurrentFolder}"
                               Foreground="{StaticResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Background-activity ticker — sits between the status line and
                         the folder path. Hidden when nothing is running so it doesn't
                         reserve dead space. -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBackgroundActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="⏳"
                                   Margin="0,0,4,0"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackgroundActivity}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextBrush}" />
                </DockPanel>

                <!-- Filmstrip show/hide toggle, centred in the bottom bar. ▲ brings the
                     filmstrip back when it's hidden; ▼ dismisses it when it's showing.
                     Windowed only — the status bar is collapsed in fullscreen, which
                     keeps its own pull-tab / close button for that case. -->
                <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="18,0" FontSize="10"
                        Command="{Binding ToggleFilmstripCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="&#x25B2;" />
                            <Setter Property="ToolTip" Value="Show the filmstrip (F6)" />
                            <Setter Property="Opacity" Value="0.85" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowFilmstrip}" Value="True">
                                    <Setter Property="Content" Value="&#x25BC;" />
                                    <Setter Property="ToolTip" Value="Hide the filmstrip (F6)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="PhotoFullscreenTransitionOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              Panel.ZIndex="1000"
              Background="#FF0E0E0E"
              IsHitTestVisible="False"
              Opacity="0"
              Visibility="Collapsed" />
    </Grid>
</Window>
