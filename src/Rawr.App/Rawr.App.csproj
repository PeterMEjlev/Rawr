<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\rawr.ico</ApplicationIcon>
    <AssemblyName>RAWR</AssemblyName>
    <RootNamespace>Rawr.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.*" />
    <PackageReference Include="GMap.NET.WindowsPresentation" Version="1.*" />
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\rawr.ico" />

    <!-- LibRaw native DLLs and their dependencies. Place all DLLs in src/Rawr.App/native/ -->
    <Content Include="native\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- ONNX models for face / closed-eye detection. Optional — feature degrades
         gracefully if the files are absent. See models/README.md for sources. -->
    <Content Include="models\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rawr.Core\Rawr.Core.csproj" />
    <ProjectReference Include="..\Rawr.Raw\Rawr.Raw.csproj" />
  </ItemGroup>

</Project>
