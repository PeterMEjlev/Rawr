<Window x:Class="Rawr.App.Dialogs.SecondMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAWR — Preview"
        Width="1280" Height="720"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="True"
        Background="#FF000000"
        Foreground="{StaticResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F11"    Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Background="#FF000000">
        <!-- Still-image preview, fit-to-screen -->
        <Image Source="{Binding PreviewImage}"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding VideoSourceUri, Converter={StaticResource NotNullToCollapsed}}" />

        <!-- Focus-peaking overlay (matches PreviewImage layout because both use Stretch=Uniform) -->
        <Image Source="{Binding FocusPeakingOverlay}"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               IsHitTestVisible="False"
               Visibility="{Binding FocusPeakingEnabled, Converter={StaticResource NullToVisibility}}" />

        <!-- Clipping overlay -->
        <Image Source="{Binding ClippingOverlay}"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               IsHitTestVisible="False"
               Visibility="{Binding ClippingEnabled, Converter={StaticResource NullToVisibility}}" />

        <!-- Video placeholder: still preview not used while a video is selected;
             the file is being played on the main window's MediaElement. -->
        <TextBlock Text="Video preview is shown on the main window."
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding VideoSourceUri, Converter={StaticResource NullToVisibility}}" />

        <!-- Empty state -->
        <TextBlock Text="No photo selected"
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding SelectedPhoto, Converter={StaticResource NotNullToCollapsed}}" />

        <!-- Hint badge: visible briefly via opacity, kept dim so it doesn't distract -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Background="#80000000"
                CornerRadius="3"
                Padding="8,3"
                IsHitTestVisible="False">
            <TextBlock Text="Esc to close" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
        </Border>
    </Grid>
</Window>
