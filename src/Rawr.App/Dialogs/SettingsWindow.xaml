<Window x:Class="Rawr.App.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="640"
        Width="760"
        MinHeight="440"
        MinWidth="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="#FFE6E6E6"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <!-- Editable value display next to a slider. The Text binding is set
             per-instance (different slider names / formats); this style only
             carries the shared chrome + the Enter-key handler that commits
             the binding without waiting for LostFocus. The Slider clamps the
             value to its Minimum/Maximum once the binding propagates back. -->
        <Style x:Key="SliderValueBox" TargetType="TextBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,0,2,0" />
            <!-- Look like a plain label: no chrome, transparent background.
                 The user still gets caret + selection + typing on focus. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="{TemplateBinding Background}"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewKeyDown" Handler="SliderValueBox_PreviewKeyDown" />
        </Style>

        <!-- Per-setting "revert to default" button. Tag carries the AppSettings
             property name (or a synthetic key for radio groups); Reset_Click
             dispatches on it. Same minimal chrome as SliderValueBox so it sits
             inline with each row without dominating. -->
        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Content" Value="↺" />
            <Setter Property="ToolTip" Value="Revert to default" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Reset_Click" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="12,12,12,0">

            <!-- ── GENERAL TAB ── -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <!-- Date format -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="DISPLAY" Style="{StaticResource SectionCardHeader}" />
                                <TextBlock Text="Date format" Margin="0,0,0,4" />
                                <TextBox x:Name="DateFormatBox"
                                         TextChanged="DateFormatBox_TextChanged"
                                         Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Preview: " Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DatePreview" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="Presets:" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="dd-MM-yyyy" Tag="dd-MM-yyyy  HH:mm:ss" Click="Preset_Click" Margin="0,0,4,0" Padding="6,3" />
                                    <Button Content="MM/dd/yyyy" Tag="MM/dd/yyyy  HH:mm:ss" Click="Preset_Click" Margin="0,0,4,0" Padding="6,3" />
                                    <Button Content="yyyy-MM-dd" Tag="yyyy-MM-dd  HH:mm:ss" Click="Preset_Click" Padding="6,3" />
                                    <Button Style="{StaticResource ResetButton}" Tag="DateFormat" />
                                </StackPanel>
                                <TextBlock Text="Uses .NET date format strings (e.g. dd-MM-yyyy HH:mm:ss)."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Zoom -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="ZOOM" Style="{StaticResource SectionCardHeader}" />
                                <TextBlock Text="Double-click zoom level" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Slider x:Name="DoubleClickZoomSlider"
                                            Minimum="1.5" Maximum="16"
                                            SmallChange="0.5" LargeChange="1"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Width="280"
                                            VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource SliderValueBox}"
                                             Text="{Binding ElementName=DoubleClickZoomSlider, Path=Value, StringFormat={}{0:F1}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="×" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                    <Button Style="{StaticResource ResetButton}" Tag="DoubleClickZoom" />
                                </StackPanel>
                                <TextBlock Text="Zoom level applied when double-clicking a photo in the preview."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Scrolling -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="SCROLLING" Style="{StaticResource SectionCardHeader}" />
                                <TextBlock Text="Mouse wheel scroll speed" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Slower" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider x:Name="ScrollSpeedSlider"
                                            Minimum="25" Maximum="200"
                                            SmallChange="5" LargeChange="25"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            Width="220"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Faster" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBox Style="{StaticResource SliderValueBox}"
                                             Text="{Binding ElementName=ScrollSpeedSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                    <Button Style="{StaticResource ResetButton}" Tag="ScrollSpeedPercent" />
                                </StackPanel>
                                <TextBlock Text="Affects wheel scrolling in the grid, filmstrips, and settings panels."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="ReverseFilmstripScrollCheck"
                                              Content="Reverse filmstrip scroll direction"
                                              VerticalAlignment="Center" />
                                    <Button Style="{StaticResource ResetButton}" Tag="ReverseFilmstripScroll" />
                                </StackPanel>
                                <TextBlock Text="Swaps the scroll direction when using the mouse wheel in the filmstrip."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Preview -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="PREVIEW" Style="{StaticResource SectionCardHeader}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="UseEmbeddedJpegOnlyCheck"
                                              Content="Use embedded JPEG only (skip RAW decoding)"
                                              VerticalAlignment="Center" />
                                    <Button Style="{StaticResource ResetButton}" Tag="UseEmbeddedJpegOnly" />
                                </StackPanel>
                                <TextBlock Text="Stays on the camera's embedded JPEG instead of decoding the linear RAW. Avoids the colour noise visible when zooming in. Disables clipping detection and falls back to JPEG-based exposure adjustment."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Sorting -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="SORTING" Style="{StaticResource SectionCardHeader}" />
                                <TextBlock Text="Default sort when opening a folder" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="SortFieldBox" MinWidth="160" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource ResetButton}" Tag="DefaultSortField" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── AUTO GROUPING TAB ── -->
            <TabItem Header="Auto Grouping">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <!-- ─── Bursts ─── -->
                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="BURSTS" Style="{StaticResource SectionCardHeader}" />

                        <TextBlock Text="Max gap between shots" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Slider x:Name="GapSlider"
                                    Minimum="1" Maximum="30"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="280"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=GapSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="s" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="BurstMaxGapSeconds" />
                        </StackPanel>
                        <TextBlock Text="Photos taken within this interval on the same camera are grouped into a burst."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Visual similarity" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="SimilaritySlider"
                                    Minimum="0" Maximum="100"
                                    SmallChange="5" LargeChange="10"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SimilaritySlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="BurstSimilarityStrictness" />
                        </StackPanel>
                        <TextBlock Text="How visually similar two shots must be to join the same burst. Lower groups looser scenes; higher only groups near-identical frames."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Group thumbnail" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="BurstThumbnailMode" />
                        </StackPanel>
                        <RadioButton x:Name="ThumbHighestRated"
                                     Content="Highest rated  (falls back to first chronological)"
                                     GroupName="BurstThumb"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="ThumbFirstChronological"
                                     Content="First chronological"
                                     GroupName="BurstThumb"
                                     Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="CollapseOnOpen"
                                      Content="Collapse bursts when opening a folder"
                                      VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="CollapseBurstsOnOpen" />
                        </StackPanel>
                        <TextBlock Text="When enabled, each burst shows as a single stacked tile on folder load."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                        </StackPanel>
                        </Border>

                        <!-- ─── HDR ─── -->
                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="HDR / AUTO-BRACKET" Style="{StaticResource SectionCardHeader}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="HdrEnabledCheck"
                                      Content="Detect HDR / auto-bracket sequences"
                                      VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="HdrDetectionEnabled" />
                        </StackPanel>
                        <TextBlock Text="Tags brackets shot of the same scene at different exposures with the system HDR tag and groups them like a burst."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Minimum frames in a bracket" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Slider x:Name="HdrMinBracketSizeSlider"
                                    Minimum="2" Maximum="7"
                                    SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=HdrMinBracketSizeSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="frames" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="HdrMinBracketSize" />
                        </StackPanel>
                        <TextBlock Text="Most cameras shoot 3-, 5-, or 7-frame brackets. Higher values reject short brackets."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Minimum exposure spread" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="HdrExposureSpreadSlider"
                                    Minimum="0.3" Maximum="3.0"
                                    SmallChange="0.1" LargeChange="0.5"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=HdrExposureSpreadSlider, Path=Value, StringFormat={}{0:F1}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="EV" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="HdrMinExposureSpread" />
                        </StackPanel>
                        <TextBlock Text="Total exposure range that must span the bracket. Lower catches subtle ±⅓ EV brackets; higher only flags wide ±2 EV sweeps."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                        </StackPanel>
                        </Border>

                        <!-- ─── Panorama ─── -->
                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="PANORAMA" Style="{StaticResource SectionCardHeader}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="PanoEnabledCheck"
                                      Content="Detect panorama sweeps"
                                      VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaDetectionEnabled" />
                        </StackPanel>
                        <TextBlock Text="Chains adjacent shots whose camera-pan shift is consistent in direction. Detected sequences get the system Panorama tag and stack as a burst."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Minimum frames in a panorama" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Slider x:Name="PanoMinChainSlider"
                                    Minimum="2" Maximum="7"
                                    SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=PanoMinChainSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="frames" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaMinChainSize" />
                        </StackPanel>
                        <TextBlock Text="Reject sequences shorter than this. 3 catches most panoramas; 5+ avoids stray two-frame matches."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Max gap between shots" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Slider x:Name="PanoGapSlider"
                                    Minimum="1" Maximum="60"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="280"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=PanoGapSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="s" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaMaxGapSeconds" />
                        </StackPanel>
                        <TextBlock Text="Photographers often pace panoramas slowly. Raise this if your panos take longer between frames; lower it to avoid chaining unrelated shots."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Frame overlap range" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Min" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="PanoMinOverlapSlider"
                                    Minimum="5" Maximum="50"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=PanoMinOverlapSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaMinOverlapPct" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Max" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="PanoMaxOverlapSlider"
                                    Minimum="50" Maximum="95"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=PanoMaxOverlapSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaMaxOverlapPct" />
                        </StackPanel>
                        <TextBlock Text="Frames must overlap within this range. Above max = treated as a regular burst; below min = unrelated shots."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Direction tolerance" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Stricter" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="PanoDirectionSlider"
                                    Minimum="5" Maximum="90"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Looser" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=PanoDirectionSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="°" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="PanoramaDirectionToleranceDeg" />
                        </StackPanel>
                        <TextBlock Text="Allowed direction change between consecutive panorama frames. Lower forces a near-perfect sweep; higher tolerates handheld drift."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                        </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── HIGHLIGHTS / SHADOWS TAB ── -->
            <TabItem Header="Clipping">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="CLIPPING DETECTION" Style="{StaticResource SectionCardHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="What to flag" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="ClippingMode" />
                        </StackPanel>
                        <RadioButton x:Name="ClippingModeHighlights"
                                     Content="Clipped highlights only"
                                     GroupName="ClippingMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="ClippingModeShadows"
                                     Content="Crushed shadows only"
                                     GroupName="ClippingMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="ClippingModeBoth"
                                     Content="Both highlights and shadows"
                                     GroupName="ClippingMode"
                                     Margin="0,0,0,14" />

                        <TextBlock Text="Threshold (%)" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="ClippingThresholdSlider"
                                    Minimum="90" Maximum="100"
                                    SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=ClippingThresholdSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="ClippingThreshold" />
                        </StackPanel>
                        <TextBlock Text="Highlights are flagged when any channel reaches this percentage of sensor max. Shadows are flagged when every channel is within (100 − threshold)% of sensor black. Lower values are more permissive."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="Sidebar bucket sensitivity (% of pixels)" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="ClippedAreaThresholdSlider"
                                    Minimum="1" Maximum="50"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=ClippedAreaThresholdSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="ClippedAreaThreshold" />
                        </StackPanel>
                        <TextBlock Text="Minimum share of pixels that must be clipped for a photo to appear in the sidebar's Clipped Highlights / Crushed Shadows buckets."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                        </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── CLASSIFICATION TAB (faces + subjects) ── -->
            <TabItem Header="Classification">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="FACES / EYES" Style="{StaticResource SectionCardHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="When to run" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="ClosedEyeDetectionMode" />
                        </StackPanel>
                        <RadioButton x:Name="ClosedEyeModeAuto"
                                     Content="Automatically on folder open"
                                     GroupName="ClosedEyeMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="ClosedEyeModeManual"
                                     Content="Manually (from the Analyze menu)"
                                     GroupName="ClosedEyeMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="ClosedEyeModeOff"
                                     Content="Off"
                                     GroupName="ClosedEyeMode"
                                     Margin="0,0,0,12" />
                        <TextBlock Text="Closed-eye sensitivity (%)" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="ClosedEyeThresholdSlider"
                                    Minimum="10" Maximum="90"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=ClosedEyeThresholdSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                            <Button Style="{StaticResource ResetButton}" Tag="ClosedEyeThreshold" />
                        </StackPanel>
                        <TextBlock Text="An eye counts as closed when the classifier's open-eye confidence falls below this threshold. Higher values are stricter (fewer photos flagged). Auto runs on folder open; Manual runs from the toolbar Analyze menu."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button x:Name="RerunFaceAnalysisButton"
                                Content="↻ Re-run face analysis on this folder"
                                Click="RerunFaceAnalysis_Click"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                ToolTip="Clear every photo's face/eye results and re-run with the current threshold. Saves and closes Settings before running." />
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="SUBJECTS (ZERO-SHOT CLIP)" Style="{StaticResource SectionCardHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="When to run" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectClassificationMode" />
                        </StackPanel>
                        <RadioButton x:Name="SubjectModeAuto"
                                     Content="Automatically on folder open"
                                     GroupName="SubjectMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="SubjectModeManual"
                                     Content="Manually (from the Analyze menu)"
                                     GroupName="SubjectMode"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="SubjectModeOff"
                                     Content="Off"
                                     GroupName="SubjectMode"
                                     Margin="0,0,0,12" />
                        <TextBlock Text="Subject-match sensitivity per group (5–50, higher = stricter)" Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Person" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdPersonSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdPersonSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdPerson" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Animal" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdAnimalSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdAnimalSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdAnimal" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Vehicle" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdVehicleSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdVehicleSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdVehicle" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Nature" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdNatureSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdNatureSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdNature" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Architecture" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdArchitectureSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdArchitectureSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdArchitecture" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Food" Width="86" VerticalAlignment="Center" />
                            <Slider x:Name="SubjectThresholdFoodSlider"
                                    Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="190" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=SubjectThresholdFoodSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="SubjectThresholdFood" />
                        </StackPanel>
                        <TextBlock Text="Per-group match threshold × 100. Within each group, categories compete in a softmax (against each other and a background anchor); a group is tagged when its probability clears its threshold. Raise a group's value if it over-fires (e.g. Animal tagging mountains), lower it if real subjects are missed. Requires subject_image_encoder.onnx + subject_tags.json in models/ (see models/README.md)."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button x:Name="RerunSubjectClassificationButton"
                                Content="↻ Re-run subject classification on this folder"
                                Click="RerunSubjectClassification_Click"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                ToolTip="Clear every photo's subject tags and re-classify with the current threshold. Saves and closes Settings before running." />
                        </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── FOCUS TAB ── -->
            <TabItem Header="Focus Peaking">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                        <TextBlock Text="FOCUS PEAKING" Style="{StaticResource SectionCardHeader}" />
                        <TextBlock Text="Strictness" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Looser"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="FocusPeakingStrictnessSlider"
                                    Minimum="10" Maximum="100"
                                    SmallChange="5" LargeChange="10"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Width="220"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Stricter"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBox Style="{StaticResource SliderValueBox}"
                                     Text="{Binding ElementName=FocusPeakingStrictnessSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Style="{StaticResource ResetButton}" Tag="FocusPeakingThreshold" />
                        </StackPanel>
                        <TextBlock Text="Higher values highlight only very sharp in-focus edges. Lower values also include softer transitions."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                        </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── VIDEO TAB ── -->
            <TabItem Header="Video">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel Margin="16,14">

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="PLAYBACK" Style="{StaticResource SectionCardHeader}" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="AutoPlayVideoCheck"
                                              Content="Auto-play videos when selected"
                                              VerticalAlignment="Center" />
                                    <Button Style="{StaticResource ResetButton}" Tag="AutoPlayVideo" />
                                </StackPanel>
                                <TextBlock Text="When off, videos load with the first frame visible but stay paused — press Space to play."
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />

                                <TextBlock Text="Seek step (Shift + Left / Right)" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Slider x:Name="VideoSeekStepSlider"
                                            Minimum="1" Maximum="30"
                                            SmallChange="1" LargeChange="5"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Width="220"
                                            VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource SliderValueBox}"
                                             Text="{Binding ElementName=VideoSeekStepSlider, Path=Value, StringFormat={}{0:F0}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="s" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                    <Button Style="{StaticResource ResetButton}" Tag="VideoSeekStepSeconds" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── MACROS TAB ── -->
            <TabItem Header="Macros">
                <Border Style="{StaticResource SectionCard}" Margin="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="KEYBOARD MACROS"
                                       Style="{StaticResource SectionCardHeader}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="One key combo applies a sequence of edits (flag, rating, color, tag) to the current selection as a single undoable step. Macros override built-in shortcuts on the same key."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                            <StackPanel x:Name="MacrosHost" />
                        </ScrollViewer>
                        <Button Grid.Row="3"
                                Content="+ Add macro"
                                HorizontalAlignment="Left"
                                Padding="8,4"
                                Margin="0,8,0,0"
                                Click="AddMacro_Click" />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ── SHORTCUTS TAB ── -->
            <TabItem Header="Shortcuts">
                <Border Style="{StaticResource SectionCard}" Margin="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="KEYBOARD SHORTCUTS"
                                       Style="{StaticResource SectionCardHeader}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Reset all"
                                    Click="ResetAllShortcuts_Click"
                                    Padding="6,3"
                                    ToolTip="Restore every shortcut to its default" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="Click a binding to record a new key. Esc cancels, Backspace clears the binding."
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                            <StackPanel x:Name="ShortcutsHost" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ── Buttons ── -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="Save_Click" MinWidth="72" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="72" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
