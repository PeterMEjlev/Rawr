<Window x:Class="Rawr.App.Dialogs.BurstFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Rawr.Core.Models;assembly=Rawr.Core"
        xmlns:controls="clr-namespace:Rawr.App.Controls"
        Title="Burst"
        Height="720" Width="1380"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <!-- Per-frame shortcuts (P, X, U, T, ratings, colors, navigation) and macros are
         applied programmatically in code-behind so they honour user customisation
         from Settings. Escape and Down stay here as window-close conventions. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Down" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                x:Name="HeaderBar"
                Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="HeaderText"
                           DockPanel.Dock="Left"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right"
                           Text="Esc to close"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding SetAsThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="0,0,12,0"
                        Padding="10,3"
                        VerticalAlignment="Center"
                        ToolTip="Press T to toggle this frame as the burst thumbnail">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Set as thumbnail (T)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPhoto.IsBestInGroup, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Content" Value="✓ Burst thumbnail (T to unpin)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- Main preview + metadata panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Preview area -->
            <Grid Grid.Column="0" Background="#FF0E0E0E">
                <Border x:Name="PreviewHost"
                        Background="Transparent"
                        ClipToBounds="True"
                        MouseWheel="PreviewHost_MouseWheel"
                        MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
                        MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp"
                        MouseMove="PreviewHost_MouseMove">
                    <Grid>
                        <Image x:Name="PreviewImageElement"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8"
                               RenderTransformOrigin="0,0">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Clipping warning overlay — shares transforms with PreviewImageElement -->
                        <Image x:Name="ClippingOverlayImage"
                               Source="{Binding ClippingOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8"
                               RenderTransformOrigin="0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding ClippingEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScale}"
                                                    ScaleY="{Binding ScaleY, ElementName=PreviewScale}" />
                                    <TranslateTransform X="{Binding X, ElementName=PreviewTranslate}"
                                                        Y="{Binding Y, ElementName=PreviewTranslate}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Focus peaking overlay — shares transforms with PreviewImageElement -->
                        <Image x:Name="FocusPeakingOverlayImage"
                               Source="{Binding FocusPeakingOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Linear"
                               Margin="8"
                               RenderTransformOrigin="0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding FocusPeakingEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScale}"
                                                    ScaleY="{Binding ScaleY, ElementName=PreviewScale}" />
                                    <TranslateTransform X="{Binding X, ElementName=PreviewTranslate}"
                                                        Y="{Binding Y, ElementName=PreviewTranslate}" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>

                <!-- Star rating + flag overlay -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            IsHitTestVisible="False">
                    <Border Background="#80000000"
                            Padding="8,4"
                            CornerRadius="3"
                            Margin="0,0,0,4">
                        <TextBlock x:Name="RatingText"
                                   Foreground="{StaticResource StarBrush}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#80000000"
                            Padding="8,4"
                            CornerRadius="3"
                            x:Name="FlagBadge"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FlagText" Foreground="White" FontSize="12" />
                    </Border>
                </StackPanel>

                <!-- Focus peaking active badge (bottom-left) -->
                <Border Background="#CC1E40AF"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,16"
                        IsHitTestVisible="False"
                        Visibility="{Binding FocusPeakingEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="FOCUS PEAK"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <!-- Clipping active badge (bottom-left, displaces focus-peak badge) -->
                <Border Background="#CC991B1B"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,16"
                        IsHitTestVisible="False"
                        Visibility="{Binding ClippingEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="CLIPPING"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <!-- Zoom indicator (bottom-right) -->
                <Border Background="#80000000"
                        Padding="6,2"
                        CornerRadius="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        IsHitTestVisible="False"
                        x:Name="ZoomIndicator"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ZoomIndicatorText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="11" />
                </Border>
            </Grid>

            <!-- Metadata panel -->
            <controls:PhotoInfoPanel x:Name="PhotoInfoPanelControl"
                                     Grid.Column="1"
                                     Photo="{Binding CurrentPhoto, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CaptureDateText="{Binding CurrentPhotoCaptureDateFormatted, RelativeSource={RelativeSource AncestorType=Window}}"
                                     HistogramData="{Binding HistogramData, RelativeSource={RelativeSource AncestorType=Window}}"
                                     HistogramMode="{Binding HistogramMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SidePanelView="{Binding SidePanelView, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SetSidePanelViewCommand="{Binding SetSidePanelViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SetHistogramModeCommand="{Binding SetHistogramModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
        <!-- Filmstrip -->
        <Border Grid.Row="2"
                Background="{StaticResource BgFilmstripBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <ListBox x:Name="Strip"
                     ItemContainerStyle="{StaticResource BurstStripItemStyle}"
                     SelectionChanged="Strip_SelectionChanged"
                     PreviewMouseWheel="Strip_PreviewMouseWheel"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PhotoItem}">
                        <Grid Width="140">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF0E0E0E">
                                <Grid>
                                    <Image Source="{Binding ThumbnailJpeg, Converter={StaticResource ThumbBytesToImage}}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                    <Rectangle Width="3"
                                               HorizontalAlignment="Left"
                                               Fill="{Binding Flag, Converter={StaticResource FlagToBrush}}" />
                                    <Ellipse Width="8" Height="8"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,4,4,0"
                                             Fill="{Binding ColorLabel, Converter={StaticResource LabelToBrush}}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="#A0000000"
                                            Padding="4,1" Margin="2"
                                            CornerRadius="2"
                                            Visibility="{Binding Rating, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStars}}"
                                                   Foreground="{StaticResource StarBrush}"
                                                   FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding FileName}"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="2,2,2,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
