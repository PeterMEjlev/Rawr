<Window x:Class="Rawr.App.Dialogs.ImportDialog"
        x:Name="DialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from card"
        Width="1400" Height="1000"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="#FFE6E6E6"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Source header -->
            <RowDefinition Height="Auto" /> <!-- Select-all toolbar -->
            <RowDefinition Height="*" />    <!-- Files (left) + Destination panel (right) -->
            <RowDefinition Height="Auto" /> <!-- Status / progress -->
            <RowDefinition Height="Auto" /> <!-- Organize by type -->
            <RowDefinition Height="Auto" /> <!-- Options + buttons -->
        </Grid.RowDefinitions>

        <!-- Source -->
        <Border Grid.Row="0"
                Style="{StaticResource SectionCard}"
                Padding="14,10">
            <StackPanel>
                <TextBlock Text="SOURCE" Style="{StaticResource SectionCardHeader}" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SourceText" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Margin="10,0,0,0"
                            Padding="10,3"
                            Click="BrowseSource_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Select-all toolbar + view-mode toggle -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,4">
            <CheckBox x:Name="SelectAllCheck" DockPanel.Dock="Left"
                      Content="Select all"
                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="SelectionSummary"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource TextDimBrush}" />
                <RadioButton x:Name="ViewModeList"
                             Content="List"
                             GroupName="ImportViewMode"
                             Checked="ViewMode_Changed"
                             Padding="6,2"
                             VerticalContentAlignment="Center"
                             Margin="0,0,4,0" />
                <RadioButton x:Name="ViewModeGrid"
                             Content="Grid"
                             GroupName="ImportViewMode"
                             IsChecked="True"
                             Checked="ViewMode_Changed"
                             Padding="6,2"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Files (left) + Destination panel (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

        <!-- File list (list + grid view; visibility toggled by ViewMode_Changed) -->
        <Border Grid.Column="0"
                Style="{StaticResource SectionCard}"
                Padding="0"
                Margin="0"
                ClipToBounds="True">
            <Grid>
                <ListView x:Name="FileList"
                          SelectionMode="Extended"
                          BorderThickness="0"
                          Background="Transparent"
                          Visibility="Collapsed"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsImportable}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" DisplayMemberBinding="{Binding RelativePath}" Width="320" />
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding ModifiedText}" Width="160" />
                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                            <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="80" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <ListView x:Name="FileGrid"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          PreviewMouseWheel="FileGrid_PreviewMouseWheel">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding TileSize, ElementName=DialogRoot}"
                                    Height="{Binding TileSize, ElementName=DialogRoot}"
                                    Margin="6"
                                    Background="#FF242424"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail area -->
                                    <Grid Grid.Row="0" Margin="4">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Placeholder while thumbnail loads -->
                                        <TextBlock Text="…"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Video badge -->
                                        <Border Background="#99000000"
                                                CornerRadius="2"
                                                Padding="4,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="2"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <TextBlock Text="▶ VIDEO" FontSize="9" Foreground="White" />
                                        </Border>
                                        <!-- Selection indicator (visual only; tile is the click target) -->
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Margin="2"
                                                  Background="#80000000"
                                                  IsHitTestVisible="False"
                                                  Focusable="False" />
                                    </Grid>

                                    <!-- Filename -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"
                                               Margin="4,2,4,6"
                                               FontSize="11"
                                               ToolTip="{Binding RelativePath}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Destination panel -->
            <Border Grid.Column="2"
                    Style="{StaticResource SectionCard}"
                    Padding="0"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="Auto" /> <!-- Path box + Browse -->
                        <RowDefinition Height="*" />    <!-- Folder tree -->
                        <RowDefinition Height="Auto" /> <!-- Empty hint -->
                        <RowDefinition Height="Auto" /> <!-- New folder button -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DESTINATION"
                               Style="{StaticResource SectionCardHeader}"
                               Margin="14,12,14,4" />

                    <Grid Grid.Row="1" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationBox"
                                 Grid.Column="0"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                Click="Browse_Click" />
                    </Grid>

                    <TreeView x:Name="DestinationTree"
                              Grid.Row="2"
                              Margin="6,0,6,4"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="DestinationTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M 1.5,1 L 4.5,1 A 1,1 0 0 1 5.5,2 L 6.5,3 L 12.5,3 A 1,1 0 0 1 13.5,4 L 13.5,9 A 1,1 0 0 1 12.5,10 L 1.5,10 A 1,1 0 0 1 0.5,9 L 0.5,2 A 1,1 0 0 1 1.5,1 Z"
                                          StrokeThickness="1"
                                          StrokeLineJoin="Round"
                                          Width="14" Height="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          SnapsToDevicePixels="True">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock x:Name="EmptyTreeHint"
                               Grid.Row="3"
                               Text="No folder open in RAWR. Use Browse to choose a destination."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               Margin="10,4,10,6"
                               Visibility="Collapsed" />

                    <Button Grid.Row="4"
                            x:Name="NewFolderButton"
                            Content="+ New Folder"
                            Margin="10,0,10,10"
                            Padding="8,4"
                            HorizontalAlignment="Stretch"
                            Click="NewFolder_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- Status / progress -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDimBrush}" />
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="1"
                         Height="6"
                         Margin="0,4,0,0"
                         Minimum="0" Maximum="1"
                         Visibility="Collapsed" />
        </Grid>

        <!-- Organize by file type -->
        <Border Grid.Row="4"
                x:Name="OrganizeCard"
                Style="{StaticResource SectionCard}"
                Padding="14,10"
                Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ORGANIZE" Style="{StaticResource SectionCardHeader}" />
                    <TextBlock Grid.Column="1"
                               Text="By default everything imports flat into the destination."
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Destination"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="10"
                               Margin="0,0,0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Subfolder name"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="10"
                               Margin="8,0,0,2" />

                    <!-- RAW -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="RAW"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="RawModeCombo"
                              Grid.Row="1" Grid.Column="1"
                              Margin="0,2"
                              SelectionChanged="RuleCombo_SelectionChanged">
                        <ComboBoxItem Content="Main folder" />
                        <ComboBoxItem Content="Subfolder" />
                        <ComboBoxItem Content="Skip (don't import)" />
                    </ComboBox>
                    <TextBox x:Name="RawSubfolderBox"
                             Grid.Row="1" Grid.Column="2"
                             Margin="8,2,0,2"
                             VerticalAlignment="Center" />

                    <!-- JPEG -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="JPEG"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="JpegModeCombo"
                              Grid.Row="2" Grid.Column="1"
                              Margin="0,2"
                              SelectionChanged="RuleCombo_SelectionChanged">
                        <ComboBoxItem Content="Main folder" />
                        <ComboBoxItem Content="Subfolder" />
                        <ComboBoxItem Content="Skip (don't import)" />
                    </ComboBox>
                    <TextBox x:Name="JpegSubfolderBox"
                             Grid.Row="2" Grid.Column="2"
                             Margin="8,2,0,2"
                             VerticalAlignment="Center" />

                    <!-- Video -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Video"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="VideoModeCombo"
                              Grid.Row="3" Grid.Column="1"
                              Margin="0,2"
                              SelectionChanged="RuleCombo_SelectionChanged">
                        <ComboBoxItem Content="Main folder" />
                        <ComboBoxItem Content="Subfolder" />
                        <ComboBoxItem Content="Skip (don't import)" />
                    </ComboBox>
                    <TextBox x:Name="VideoSubfolderBox"
                             Grid.Row="3" Grid.Column="2"
                             Margin="8,2,0,2"
                             VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Options + buttons -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox x:Name="EjectAfterCheck"
                      DockPanel.Dock="Left"
                      Content="Eject card after import"
                      IsChecked="True"
                      VerticalAlignment="Center" />
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="80"
                    Margin="6,0,0,0" />
            <Button x:Name="ImportButton"
                    DockPanel.Dock="Right"
                    Content="Import"
                    IsDefault="True"
                    Click="Import_Click"
                    MinWidth="100" />
        </DockPanel>
    </Grid>
</Window>
