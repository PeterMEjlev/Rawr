<Window x:Class="Rawr.App.Dialogs.ImportDialog"
        x:Name="DialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from card"
        Width="780" Height="600"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgToolbarBrush}"
        Foreground="#FFE6E6E6"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Source header -->
            <RowDefinition Height="Auto" /> <!-- Destination -->
            <RowDefinition Height="Auto" /> <!-- Select-all toolbar -->
            <RowDefinition Height="*" />    <!-- File list -->
            <RowDefinition Height="Auto" /> <!-- Status / progress -->
            <RowDefinition Height="Auto" /> <!-- Options + buttons -->
        </Grid.RowDefinitions>

        <!-- Source -->
        <Border Grid.Row="0"
                Background="{StaticResource BgControlBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="10,8"
                Margin="0,0,0,10"
                CornerRadius="2">
            <StackPanel>
                <TextBlock Text="SOURCE" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                <TextBlock x:Name="SourceText" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Destination -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Destination:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="DestinationBox" Grid.Column="1" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Padding="10,3" Click="Browse_Click" />
        </Grid>

        <!-- Select-all toolbar + view-mode toggle -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,4">
            <CheckBox x:Name="SelectAllCheck" DockPanel.Dock="Left"
                      Content="Select all"
                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="SelectionSummary"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource TextDimBrush}" />
                <RadioButton x:Name="ViewModeList"
                             Content="List"
                             GroupName="ImportViewMode"
                             Checked="ViewMode_Changed"
                             Padding="6,2"
                             VerticalContentAlignment="Center"
                             Margin="0,0,4,0" />
                <RadioButton x:Name="ViewModeGrid"
                             Content="Grid"
                             GroupName="ImportViewMode"
                             IsChecked="True"
                             Checked="ViewMode_Changed"
                             Padding="6,2"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- File list (list + grid view; visibility toggled by ViewMode_Changed) -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource BgControlBrush}">
            <Grid>
                <ListView x:Name="FileList"
                          SelectionMode="Extended"
                          BorderThickness="0"
                          Background="Transparent"
                          Visibility="Collapsed"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" DisplayMemberBinding="{Binding RelativePath}" Width="320" />
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding ModifiedText}" Width="160" />
                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                            <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="80" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <ListView x:Name="FileGrid"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          PreviewMouseWheel="FileGrid_PreviewMouseWheel">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding TileSize, ElementName=DialogRoot}"
                                    Height="{Binding TileSize, ElementName=DialogRoot}"
                                    Margin="6"
                                    Background="#FF242424"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail area -->
                                    <Grid Grid.Row="0" Margin="4">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Placeholder while thumbnail loads -->
                                        <TextBlock Text="…"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Video badge -->
                                        <Border Background="#99000000"
                                                CornerRadius="2"
                                                Padding="4,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="2"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <TextBlock Text="▶ VIDEO" FontSize="9" Foreground="White" />
                                        </Border>
                                        <!-- Selection indicator (visual only; tile is the click target) -->
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Margin="2"
                                                  Background="#80000000"
                                                  IsHitTestVisible="False"
                                                  Focusable="False" />
                                    </Grid>

                                    <!-- Filename -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"
                                               Margin="4,2,4,6"
                                               FontSize="11"
                                               ToolTip="{Binding RelativePath}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status / progress -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDimBrush}" />
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="1"
                         Height="6"
                         Margin="0,4,0,0"
                         Minimum="0" Maximum="1"
                         Visibility="Collapsed" />
        </Grid>

        <!-- Options + buttons -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox x:Name="EjectAfterCheck"
                      DockPanel.Dock="Left"
                      Content="Eject card after import"
                      IsChecked="True"
                      VerticalAlignment="Center" />
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="80"
                    Margin="6,0,0,0" />
            <Button x:Name="ImportButton"
                    DockPanel.Dock="Right"
                    Content="Import"
                    IsDefault="True"
                    Click="Import_Click"
                    MinWidth="100" />
        </DockPanel>
    </Grid>
</Window>
