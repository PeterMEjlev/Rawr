<Window x:Class="Rawr.App.Dialogs.AutoAnalyzePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyze this folder?"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        MinWidth="380"
        MaxWidth="460"
        Background="#FF1E1E1E"
        Foreground="#FFE6E6E6"
        FontFamily="Segoe UI"
        FontSize="12"
>
    <StackPanel Margin="18">
        <TextBlock x:Name="HeaderText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBlock Text="Running them now competes with browsing for CPU. Pick what to run on this folder — you can always run them later from the toolbar Analyze menu."
                   Foreground="#FF9A9A9A"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <CheckBox x:Name="SubjectCheck"
                  Margin="0,0,0,8"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Classify subjects" VerticalAlignment="Center" />
                <TextBlock x:Name="SubjectEstimate"
                           Foreground="#FF8FB7FF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="FaceCheck"
                  Margin="0,0,0,14"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Detect faces &amp; closed eyes" VerticalAlignment="Center" />
                <TextBlock x:Name="FaceEstimate"
                           Foreground="#FF8FB7FF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="RememberCheck"
                  Content="Don't ask again (remember this choice)"
                  Foreground="#FFB8B8B8"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Continue" IsDefault="True" Click="Continue_Click" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Not now" IsCancel="True" Click="Cancel_Click" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
