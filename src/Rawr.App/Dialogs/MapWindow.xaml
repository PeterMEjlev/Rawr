<Window x:Class="Rawr.App.Dialogs.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="RAWR — Map"
        Height="720" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel LastChildFill="False">
                <ToggleButton x:Name="DrawRectToggle"
                              DockPanel.Dock="Left"
                              Content="🔲 Draw filter rectangle"
                              Margin="0,0,8,0"
                              ToolTip="Toggle ON, then drag on the map to filter the main grid to photos in that area." />
                <Button DockPanel.Dock="Left"
                        Content="✕ Clear region filter"
                        Margin="0,0,8,0"
                        Click="OnClearRegionFilter" />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BorderBrush}" Margin="4,4" />
                <Button DockPanel.Dock="Left"
                        Content="Fit to photos"
                        Margin="0,0,8,0"
                        Click="OnFitToPhotos" />
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,4,0" />
            </DockPanel>
        </Border>

        <!-- Map + selection-rectangle overlay live in the same cell.
             The overlay only intercepts mouse input while DrawRectToggle is checked. -->
        <Grid Grid.Row="1" x:Name="MapHost">
            <gmap:GMapControl x:Name="Map"
                              MinZoom="2" MaxZoom="19"
                              Zoom="3"
                              MouseWheelZoomType="MousePositionAndCenter" />
            <Canvas x:Name="OverlayCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False">
                <Rectangle x:Name="SelectionRect"
                           Stroke="#80FFD040"
                           StrokeThickness="1.5"
                           Fill="#33FFD040"
                           Visibility="Collapsed" />
            </Canvas>
            <TextBlock x:Name="EmptyHint"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource TextDimBrush}"
                       Background="{StaticResource BgBrush}"
                       Padding="16,10"
                       Visibility="Collapsed"
                       Text="No photos with GPS data in this folder." />
        </Grid>

        <!-- Hint bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Foreground="{StaticResource TextDimBrush}"
                       Text="Drag = pan · Wheel = zoom · Click marker = open photo · Click cluster = zoom in" />
        </Border>
    </Grid>
</Window>
